                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="4"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>
                                                            <Button Content="Reject" Click="BtnQuickRejectPO_Click" Tag="{Binding}" Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#450A0A" Foreground="#F87171" FontSize="11" FontWeight="Bold" Padding="10,4" BorderThickness="0" Cursor="Hand">
