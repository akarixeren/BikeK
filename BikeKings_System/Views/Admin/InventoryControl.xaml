                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="9.5" FontWeight="Bold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="ACTION" Width="150">
