<UserControl x:Class="BikeKings_System.Views.Admin.InventoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1250"
             Background="#100E15"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Universal Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#251F30" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab RadioButton Style -->
        <Style x:Key="InvTabBtnStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8C849C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1D1826"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#E63956"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header Style matching Sales -->
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1C1824"/>
            <Setter Property="Foreground" Value="#8C849C"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#2A2236"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- DataGrid Row Style matching Sales -->
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1F1A28"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C1726"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A1E33"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#16131C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#251F30"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E63956"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Root ScrollViewer with Hidden Scrollbar to eliminate the white side track -->
        <ScrollViewer x:Name="scrollViewerMain" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,24">
            <StackPanel>

                <!-- 1. INVENTORY MASTER CONTAINER -->
                <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                    <StackPanel>

                        <!-- Header Section with Badge & Actions -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦 " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Inventory Masterlist &amp; Stock Operations" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                <!-- Admin Badge -->
                                <Border x:Name="pnlAdminBadge" Background="#2D1214" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="ADMIN VIEW-ONLY (APPROVALS MODE)" FontSize="9" FontWeight="Bold" Foreground="#F87171"/>
                                </Border>

                                <!-- Clerk / Manager Badge -->
                                <Border x:Name="pnlClerkBadge" Background="#162D24" CornerRadius="4" Padding="6,2.5" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="CLERK MODE" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </StackPanel>
                            <!-- Operational Action Buttons (Compact Padding) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Export CSV Button -->
                                <Button Click="BtnExportProductsExcel_Click" Content="📥 Export CSV" Background="#221C2B" Foreground="#E2E8F0" BorderBrush="#352C44" BorderThickness="1" Height="32" Padding="10,0" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <!-- Add Product Button -->
                                <Button x:Name="btnAddProduct" Click="BtnAddProduct_Click" Content="➕ Add Product" Background="#132D23" Foreground="#34D399" BorderBrush="#1C4B36" BorderThickness="1" FontWeight="SemiBold" FontSize="11" Height="32" Padding="10,0" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <!-- Stock-In Button -->
                                <Button x:Name="btnOpenStockIn" Click="BtnOpenStockInModal_Click" Content="📥 Stock-In" Background="#2D1520" Foreground="#FB7185" BorderBrush="#4C1D2A" BorderThickness="1" FontWeight="SemiBold" FontSize="11" Height="32" Padding="10,0" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <!-- Stock-Out Button -->
                                <Button x:Name="btnOpenStockOut" Click="BtnOpenStockOutModal_Click" Content="📤 Stock-Out" Background="#2D2214" Foreground="#FBBF24" BorderBrush="#452E15" BorderThickness="1" FontWeight="SemiBold" FontSize="11" Height="32" Padding="10,0" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <!-- Create PO Button -->
                                <Button x:Name="btnTopQuickPO" Click="BtnOpenCreatePOModal_Click" Content="📋 Create PO" Background="#102436" Foreground="#38BDF8" BorderBrush="#1A3B54" BorderThickness="1" FontWeight="SemiBold" FontSize="11" Height="32" Padding="10,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ADMIN PENDING PO APPROVAL ALERT BANNER (TOP OF SCREEN) -->
                        <Border x:Name="pnlAdminPOAlertBanner" Background="#261C14" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="lblPendingPOCount" Text="2 Purchase Orders Awaiting Admin Approval" FontSize="12.5" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                    <TextBlock Text="— Submitted by Store Clerk for stock replenishment" FontSize="11.5" Foreground="#D1CCE0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Review &amp; Approve Orders ➔" Click="BtnJumpToPOTab_Click" Background="#F59E0B" Foreground="#000000" FontWeight="Bold" FontSize="11.5" Height="30" Padding="14,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Sub-Tab Navigation Bar -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="tabBtnProducts" Content="📦 Products Masterlist" IsChecked="True" Click="TabNav_Click" GroupName="InvSubTabs" Style="{StaticResource InvTabBtnStyle}"/>
                                <RadioButton x:Name="tabBtnStockIn" Content="📥 Stock-In Log" Click="TabNav_Click" GroupName="InvSubTabs" Style="{StaticResource InvTabBtnStyle}"/>
                                <RadioButton x:Name="tabBtnStockOut" Content="📤 Stock-Out Log" Click="TabNav_Click" GroupName="InvSubTabs" Style="{StaticResource InvTabBtnStyle}"/>
                                <RadioButton x:Name="tabBtnPO" Content="📋 Purchase Orders" Click="TabNav_Click" GroupName="InvSubTabs" Style="{StaticResource InvTabBtnStyle}"/>
                                <RadioButton x:Name="tabBtnAnalytics" Content="📊 Stock Analytics" Click="TabNav_Click" GroupName="InvSubTabs" Style="{StaticResource InvTabBtnStyle}"/>
                                <RadioButton x:Name="tabBtnMonitoring" Content="🔔 Monitoring" Click="TabNav_Click" GroupName="InvSubTabs" Style="{StaticResource InvTabBtnStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- TAB CONTENTS -->

                        <!-- ── TAB 1: PRODUCTS MASTERLIST (BOUNDED GRID LAYOUT) ── -->
                        <Grid x:Name="tabContentProducts" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Search & Filters -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Search Bar -->
                                <Border Grid.Row="0" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0" Margin="0,0,0,10">
                                    <Grid VerticalAlignment="Center">
                                        <TextBox x:Name="txtSearchProducts" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="12" TextChanged="TxtSearchProducts_TextChanged"/>
                                        <TextBlock Text="🔍 Search SKU, Description, Category, Brand..." Foreground="#6B667B" FontSize="12" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearchProducts}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Filters -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="cmbFilterCategory" Height="32" Background="#110E17" Foreground="#FFFFFF" BorderBrush="#2A2236" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID" SelectionChanged="CmbFilter_SelectionChanged"/>
                                    <ComboBox Grid.Column="2" x:Name="cmbFilterBrand" Height="32" Background="#110E17" Foreground="#FFFFFF" BorderBrush="#2A2236" DisplayMemberPath="BrandName" SelectedValuePath="BrandID" SelectionChanged="CmbFilter_SelectionChanged"/>
                                    <ComboBox Grid.Column="4" x:Name="cmbFilterStockStatus" Height="32" Background="#110E17" Foreground="#FFFFFF" BorderBrush="#2A2236" SelectedIndex="0" SelectionChanged="CmbFilter_SelectionChanged">
                                        <ComboBoxItem Content="All Stock Levels"/>
                                        <ComboBoxItem Content="In Stock Only"/>
                                        <ComboBoxItem Content="Low Stock Alert"/>
                                        <ComboBoxItem Content="Out of Stock"/>
                                    </ComboBox>
                                    <ComboBox Grid.Column="6" x:Name="cmbSortProducts" Height="32" Background="#110E17" Foreground="#FFFFFF" BorderBrush="#2A2236" SelectedIndex="0" SelectionChanged="CmbFilter_SelectionChanged">
                                        <ComboBoxItem Content="Sort: SKU (A-Z)"/>
                                        <ComboBoxItem Content="Sort: Product Name (A-Z)"/>
                                        <ComboBoxItem Content="Sort: ⚡ Fast-Moving (Top Sales)"/>
                                        <ComboBoxItem Content="Sort: 🐢 Slowest / Dead Stock"/>
                                        <ComboBoxItem Content="Sort: In-Stock (Lowest First)"/>
                                        <ComboBoxItem Content="Sort: In-Stock (Highest First)"/>
                                        <ComboBoxItem Content="Sort: Price (Highest First)"/>
                                    </ComboBox>
                                    <!-- ✕ Clear Filters Button -->
                                    <Button Grid.Column="8" Content="✕ Clear Filters" Click="BtnClearFilters_Click" Height="32" Background="#1D1826" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="11" Padding="14,0" BorderBrush="#2A2236" BorderThickness="1" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Row 1: Products Table (Screen-Fitted Proportional Layout) -->
                            <Border Grid.Row="1" Background="#110E17" CornerRadius="6" BorderBrush="#251F30" BorderThickness="1">
                                <DataGrid x:Name="dgProducts" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False" 
                                          CanUserResizeColumns="False"
                                          CanUserSortColumns="False"
                                          IsReadOnly="True" 
                                          GridLinesVisibility="None" 
                                          HeadersVisibility="Column" 
                                          RowHeaderWidth="0" 
                                          SelectionMode="Single" 
                                          SelectionUnit="FullRow" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="DgProducts_PreviewMouseWheel"
                                          PreviewMouseLeftButtonUp="DgProducts_PreviewMouseLeftButtonUp"
                                          Background="Transparent" 
                                          BorderThickness="0" 
                                          ColumnHeaderStyle="{StaticResource HeaderStyle}" 
                                          RowStyle="{StaticResource RowStyle}" 
                                          CellStyle="{StaticResource CellStyle}">

                                    <DataGrid.Columns>
                                        <!-- 🖼️ Product Photo Thumbnail Column -->
                                        <DataGridTemplateColumn Header="PHOTO" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="52" Height="52" CornerRadius="8" Background="#14101D" BorderBrush="#3D3252" BorderThickness="1" ClipToBounds="True" Margin="0,4">
                                                        <Grid>
                                                            <!-- Fallback silhouette icon if image is empty or loading -->
                                                            <TextBlock Text="🏍️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"/>
                                                            <Image Source="{Binding DisplayImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 1. SKU -->
                                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="Bold" Foreground="#60A5FA" Width="105"/>

                                        <!-- 2. DESCRIPTION (Flexible width with text trimming to fill remaining space) -->
                                        <DataGridTemplateColumn Header="DESCRIPTION" Width="*" MinWidth="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 3. CATEGORY -->
                                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding CategoryName}" Foreground="#9C95AD" FontSize="11" Width="110"/>

                                        <!-- 4. BRAND -->
                                        <DataGridTextColumn Header="BRAND" Binding="{Binding BrandName}" Foreground="#9C95AD" FontSize="11" Width="90"/>

                                        <!-- 5. IN-STOCK -->
                                        <DataGridTemplateColumn Header="IN-STOCK" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Quantity}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 6. COST -->
                                        <DataGridTextColumn Header="COST" Binding="{Binding CostPrice, StringFormat=₱{0:N2}}" Foreground="#9C95AD" FontSize="11" Width="80"/>

                                        <!-- 7. SELLING PRICE -->
                                        <DataGridTextColumn Header="SELLING PRICE" Binding="{Binding UnitPrice, StringFormat=₱{0:N2}}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11.5" Width="95"/>

                                        <!-- 8. STATUS BADGE -->
                                        <DataGridTemplateColumn Header="STATUS" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StockStatus}" Foreground="{Binding StatusFgColor}" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 9. ACTION BUTTONS -->
                                        <DataGridTemplateColumn Header="ACTION" Width="85">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Edit Button -->
                                                        <Button Content="✏️" ToolTip="Edit Product" Click="BtnEditProduct_Click" Tag="{Binding}" Background="#2A1E33" Foreground="#F59E0B" FontSize="11" Width="28" Height="26" Padding="0" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>

                                                        <!-- Deactivate Button -->
                                                        <Button Content="🗑️" ToolTip="Deactivate" Click="BtnDeleteProduct_Click" Tag="{Binding}" Background="#2D1214" Foreground="#EF4444" FontSize="11" Width="28" Height="26" Padding="0" BorderThickness="0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <!-- ── TAB 2: STOCK-IN LOG ── -->
                        <Grid x:Name="tabContentStockIn" Visibility="Collapsed">
                            <StackPanel>
                                <Border Background="#110E17" CornerRadius="6" BorderBrush="#251F30" BorderThickness="1">
                                    <DataGrid x:Name="dgStockIn" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" HeadersVisibility="Column" RowHeaderWidth="0" Background="Transparent" BorderThickness="0" ColumnHeaderStyle="{StaticResource HeaderStyle}" RowStyle="{StaticResource RowStyle}" CellStyle="{StaticResource CellStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DATE &amp; TIME" Binding="{Binding FormattedDate}" Foreground="#9C95AD" Width="150"/>
                                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="Bold" Foreground="#60A5FA" Width="130"/>
                                            <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding ProductName}" Foreground="#FFFFFF" Width="*"/>
                                            <DataGridTextColumn Header="QTY RECEIVED" Binding="{Binding QuantityAdjusted}" FontWeight="Bold" Foreground="#10B981" Width="110"/>
                                            <DataGridTextColumn Header="REFERENCE #" Binding="{Binding ReferenceNumber}" Foreground="#9C95AD" Width="150"/>
                                            <DataGridTextColumn Header="PROCESSED BY" Binding="{Binding ProcessedBy}" Foreground="#9C95AD" Width="120"/>
                                            <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Foreground="#9C95AD" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ── TAB 3: STOCK-OUT LOG ── -->
                        <Grid x:Name="tabContentStockOut" Visibility="Collapsed">
                            <StackPanel>
                                <Border Background="#110E17" CornerRadius="6" BorderBrush="#251F30" BorderThickness="1">
                                    <DataGrid x:Name="dgStockOut" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" HeadersVisibility="Column" RowHeaderWidth="0" Background="Transparent" BorderThickness="0" ColumnHeaderStyle="{StaticResource HeaderStyle}" RowStyle="{StaticResource RowStyle}" CellStyle="{StaticResource CellStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DATE &amp; TIME" Binding="{Binding FormattedDate}" Foreground="#9C95AD" Width="150"/>
                                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" FontWeight="Bold" Foreground="#60A5FA" Width="130"/>
                                            <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding ProductName}" Foreground="#FFFFFF" Width="*"/>
                                            <DataGridTextColumn Header="QTY DEDUCTED" Binding="{Binding QuantityAdjusted}" FontWeight="Bold" Foreground="#EF4444" Width="110"/>
                                            <DataGridTextColumn Header="REASON / DEFECT" Binding="{Binding Reason}" Foreground="#F59E0B" Width="150"/>
                                            <DataGridTextColumn Header="PROCESSED BY" Binding="{Binding ProcessedBy}" Foreground="#9C95AD" Width="120"/>
                                            <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Foreground="#9C95AD" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ── TAB 4: PURCHASE ORDERS MASTERLIST (WITH APPROVAL ACTIONS) ── -->
                        <Grid x:Name="tabContentPO" Visibility="Collapsed">
                            <StackPanel>
                                <Border Background="#110E17" CornerRadius="6" BorderBrush="#251F30" BorderThickness="1">
                                    <DataGrid x:Name="dgPurchaseOrders" 
                                              AutoGenerateColumns="False" 
                                              CanUserAddRows="False" 
                                              IsReadOnly="True" 
                                              GridLinesVisibility="None" 
                                              HeadersVisibility="Column" 
                                              RowHeaderWidth="0" 
                                              PreviewMouseLeftButtonUp="DgPurchaseOrders_PreviewMouseLeftButtonUp"
                                              MouseDoubleClick="DgPurchaseOrders_MouseDoubleClick"
                                              Background="Transparent" 
                                              BorderThickness="0" 
                                              ColumnHeaderStyle="{StaticResource HeaderStyle}" 
                                              RowStyle="{StaticResource RowStyle}" 
                                              CellStyle="{StaticResource CellStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PO REF" Binding="{Binding PONumber}" FontWeight="Bold" Foreground="#60A5FA" Width="140"/>
                                            <DataGridTextColumn Header="ORDER DATE" Binding="{Binding PODate, StringFormat=MMM dd\, yyyy\, hh:mm tt}" Foreground="#9C95AD" Width="160"/>
                                            <DataGridTextColumn Header="REQUESTER" Binding="{Binding RequesterName}" Foreground="#FFFFFF" Width="130"/>
