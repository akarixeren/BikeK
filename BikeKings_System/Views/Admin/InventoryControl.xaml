                                    <TextBox Grid.Column="0" x:Name="txtSearchAnalytics" Height="32" Background="#110E17" Foreground="#FFFFFF" BorderBrush="#251F30" BorderThickness="1" Padding="8,0" VerticalContentAlignment="Center" FontSize="12" TextChanged="TxtSearchAnalytics_TextChanged"/>
