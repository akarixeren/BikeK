                                <TextBlock Text="🔍 Search Ref No, Customer, Cashier..." Foreground="#6B667B" FontSize="11.5" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtSearchHistory}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Background="#110E17" CornerRadius="6" BorderBrush="#251F30" BorderThickness="1" MaxHeight="280" Margin="0,0,0,16">
                        <DataGrid x:Name="dgSalesHistory" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          GridLinesVisibility="None" 
                          HeadersVisibility="Column" 
                          RowHeaderWidth="0" 
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Cursor="Hand"
                          PreviewMouseLeftButtonUp="DgSalesHistory_PreviewMouseLeftButtonUp"
                          Background="Transparent" 
                          BorderThickness="0" 
                          ColumnHeaderStyle="{StaticResource HeaderStyle}" 
                          RowStyle="{StaticResource RowStyle}" 
                          CellStyle="{StaticResource CellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE &amp; TIME" Binding="{Binding FormattedDate}" Foreground="#9C95AD" Width="140"/>
                                <DataGridTextColumn Header="REF ID" Binding="{Binding ReferenceNo}" FontWeight="Bold" Foreground="#60A5FA" Width="95"/>

                                <DataGridTextColumn x:Name="colHistProfit" Header="PROFIT" Binding="{Binding FormattedProfit}" FontWeight="Bold" Foreground="#FFFFFF" Width="90"/>

                                <DataGridTemplateColumn Header="TYPE" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TypeBadgeBg}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding TypeBadgeFg}" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="CUSTOMER / DETAILS" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CustomerDetails}" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding CustomerDetails}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="QTY" Binding="{Binding QuantitySold}" FontWeight="Bold" Foreground="#FFFFFF" Width="50"/>
                                <DataGridTextColumn Header="UNIT PRICE" Binding="{Binding FormattedUnitPrice}" Foreground="#9C95AD" Width="90"/>
                                <DataGridTextColumn Header="REVENUE" Binding="{Binding FormattedRevenue}" FontWeight="Bold" Foreground="#10B981" Width="90"/>
                                <DataGridTextColumn Header="PROFIT" Binding="{Binding FormattedProfit}" FontWeight="Bold" Foreground="#FFFFFF" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Button Content="📥 Export Product History to Excel" Click="BtnExportHistoryToExcel_Click" Background="#251F30" Foreground="#FFFFFF" FontWeight="SemiBold" Height="36" Padding="16,0" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Close" Click="BtnCloseSalesHistory_Click" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" Height="36" Padding="20,0" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ── MODAL: ADD / EDIT PRODUCT ─────────────────────────── -->
        <!-- ======================================================== -->
        <Grid x:Name="modalProduct" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#16131C" BorderBrush="#352C44" BorderThickness="1" CornerRadius="12" Width="680" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock x:Name="lblModalProductTitle" Text="Add New Product" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Content="✕" Click="BtnCancelProduct_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#8C849C" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>
                    <!-- 🖼️ Product Photo / Image Editor Section -->
                    <Border Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Photo Preview Box with Placeholder Support -->
                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="8" Background="#16121F" BorderBrush="#3D3252" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <!-- Fallback Placeholder Icon -->
                                    <TextBlock Text="🏍️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"/>
                                    <Image x:Name="imgProdPreview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <!-- Controls: Browse File, Clear / Placeholder, & Path/URL -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Product Picture / Photo" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="lblProdImageStatus" Text="Using default placeholder" FontSize="10.5" Foreground="#9C95AD" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Image Path / URL -->
                                    <Border Grid.Column="0" Background="#08060B" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0">
                                        <TextBox x:Name="txtProdImagePath" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalContentAlignment="Center" FontSize="11" TextChanged="TxtProdImagePath_TextChanged"/>
                                    </Border>
                                    <!-- Browse File Button -->
                                    <Button Grid.Column="2" Content="📁 Choose Image..." Click="BtnBrowseProductImage_Click" Height="32" Padding="12,0" Background="#241E30" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Select an image file from your computer">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <!-- Clear / Default Placeholder Button -->
                                    <Button Grid.Column="4" Content="✕ Clear" Click="BtnClearProductImage_Click" Height="32" Padding="10,0" Background="#241E30" Foreground="#F87171" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Clear picture to use default category placeholder">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Select an image file (.jpg, .png) or paste a web URL. If left empty, an automatic placeholder will be assigned." FontSize="10" Foreground="#7E768C" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Product Description / Name *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                        <Border x:Name="bdrProdName" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                            <TextBox x:Name="txtProdName" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalContentAlignment="Center" TextChanged="TxtProdName_TextChanged"/>
                        </Border>
                        <TextBlock x:Name="errProdName" Text="Product name is required." Foreground="#EF4444" FontSize="10.5" Visibility="Collapsed" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrProdCategory" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6">
                                <ComboBox x:Name="cmbProdCategory" Height="36" IsEditable="True" IsTextSearchEnabled="False" PreviewKeyDown="CmbSearch_PreviewKeyDown" TextBoxBase.TextChanged="CmbSearch_TextChanged" DropDownOpened="CmbSearch_DropDownOpened" DropDownClosed="CmbSearch_DropDownClosed" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID" SelectionChanged="CmbProdCategory_SelectionChanged"/>
                            </Border>
                            <TextBlock x:Name="errProdCategory" Text="Select a category." Foreground="#EF4444" FontSize="10.5" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Brand *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrProdBrand" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6">
                                <ComboBox x:Name="cmbProdBrand" Height="36" IsEditable="True" IsTextSearchEnabled="False" PreviewKeyDown="CmbSearch_PreviewKeyDown" TextBoxBase.TextChanged="CmbSearch_TextChanged" DropDownOpened="CmbSearch_DropDownOpened" DropDownClosed="CmbSearch_DropDownClosed" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" DisplayMemberPath="BrandName" SelectedValuePath="BrandID" SelectionChanged="CmbProdBrand_SelectionChanged"/>
                            </Border>
                            <TextBlock x:Name="errProdBrand" Text="Select a brand." Foreground="#EF4444" FontSize="10.5" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Product SKU / Barcode *" FontSize="12" Foreground="#8C849C"/>
                                <Button Content="⚡ Auto-Generate" Click="BtnAutoGenerateSKU_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            </Grid>
                            <Border x:Name="bdrProdBarcode" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                                <TextBox x:Name="txtProdBarcode" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalContentAlignment="Center" TextChanged="TxtProdBarcode_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="errProdBarcode" Text="Valid SKU is required." Foreground="#EF4444" FontSize="10.5" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Supplier / Distributor" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrProdSupplier" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6">
                                <ComboBox x:Name="cmbProdSupplier" Height="36" IsEditable="True" IsTextSearchEnabled="False" PreviewKeyDown="CmbSearch_PreviewKeyDown" TextBoxBase.TextChanged="CmbSearch_TextChanged" DropDownOpened="CmbSearch_DropDownOpened" DropDownClosed="CmbSearch_DropDownClosed" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" DisplayMemberPath="SupplierName" SelectedValuePath="SupplierID"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Unit Cost Price *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrProdCost" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                                <TextBox x:Name="txtProdCost" Text="0.00" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalContentAlignment="Center" PreviewTextInput="TxtDecimal_PreviewTextInput" TextChanged="TxtProdCost_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="errProdCost" Text="Invalid cost." Foreground="#EF4444" FontSize="10" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Selling Price *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrProdPrice" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                                <TextBox x:Name="txtProdPrice" Text="0.00" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalContentAlignment="Center" PreviewTextInput="TxtDecimal_PreviewTextInput" TextChanged="TxtProdPrice_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="errProdPrice" Text="Invalid price." Foreground="#EF4444" FontSize="10" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Initial Stock *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrProdStock" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                                <TextBox x:Name="txtProdStock" Text="0" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalContentAlignment="Center" PreviewTextInput="TxtInteger_PreviewTextInput" TextChanged="TxtProdStock_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="errProdStock" Text="Invalid stock." Foreground="#EF4444" FontSize="10" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Reorder Point *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrProdReorder" Background="#0F0C15" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                                <TextBox x:Name="txtProdReorder" Text="5" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalContentAlignment="Center" PreviewTextInput="TxtInteger_PreviewTextInput" TextChanged="TxtProdReorder_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="errProdReorder" Text="Invalid level." Foreground="#EF4444" FontSize="10" Visibility="Collapsed" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="BtnCancelProduct_Click" Background="#251F30" Foreground="#8C849C" BorderThickness="0" Height="36" Padding="16,0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Save Product" Click="BtnSaveProduct_Click" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Height="36" Padding="20,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ── MODAL: STOCK-IN (RECEIVING) ───────────────────────── -->
        <!-- ======================================================== -->
        <Grid x:Name="modalStockIn" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#16131C" BorderBrush="#352C44" BorderThickness="1" CornerRadius="12" Width="540" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="📥 Record Stock-In Delivery" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Content="✕" Click="BtnCancelStockIn_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#8C849C" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Select Product to Restock *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbStockInProduct" Height="36" IsEditable="True" IsTextSearchEnabled="False" PreviewKeyDown="CmbSearch_PreviewKeyDown" TextBoxBase.TextChanged="CmbSearch_TextChanged" DropDownOpened="CmbSearch_DropDownOpened" DropDownClosed="CmbSearch_DropDownClosed" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" DisplayMemberPath="ProductName" SelectedValuePath="ProductID" SelectionChanged="CmbStockInProduct_SelectionChanged"/>
                        <TextBlock x:Name="lblStockInCurrentQty" Text="Current In-Stock: -" FontSize="11" Foreground="#38BDF8" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Supplier / Distributor *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbStockInSupplier" Height="36" IsEditable="True" IsTextSearchEnabled="False" PreviewKeyDown="CmbSearch_PreviewKeyDown" TextBoxBase.TextChanged="CmbSearch_TextChanged" DropDownOpened="CmbSearch_DropDownOpened" DropDownClosed="CmbSearch_DropDownClosed" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" DisplayMemberPath="SupplierName" SelectedValuePath="SupplierID"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quantity Received *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtStockInQty" Text="1" Height="36" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" Padding="8,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reference / Invoice #" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtStockInRef" Height="36" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" Padding="8,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Delivery Notes / Remarks" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtStockInNotes" Height="36" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="BtnCancelStockIn_Click" Background="#251F30" Foreground="#8C849C" BorderThickness="0" Height="36" Padding="16,0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Confirm Stock-In" Click="BtnSaveStockIn_Click" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Height="36" Padding="20,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ── MODAL: STOCK-OUT (ADJUSTMENT) ─────────────────────── -->
        <!-- ======================================================== -->
        <Grid x:Name="modalStockOut" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#16131C" BorderBrush="#352C44" BorderThickness="1" CornerRadius="12" Width="540" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="📤 Record Stock-Out / Deduction" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Content="✕" Click="BtnCancelStockOut_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#8C849C" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Select Product *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbStockOutProduct" Height="36" IsEditable="True" IsTextSearchEnabled="False" PreviewKeyDown="CmbSearch_PreviewKeyDown" TextBoxBase.TextChanged="CmbSearch_TextChanged" DropDownOpened="CmbSearch_DropDownOpened" DropDownClosed="CmbSearch_DropDownClosed" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" DisplayMemberPath="ProductName" SelectedValuePath="ProductID" SelectionChanged="CmbStockOutProduct_SelectionChanged"/>
                        <TextBlock x:Name="lblStockOutCurrentQty" Text="Current In-Stock: -" FontSize="11" Foreground="#38BDF8" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quantity to Deduct *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtStockOutQty" Text="1" Height="36" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" Padding="8,0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Reason for Deduction *" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbStockOutReason" Height="36" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" SelectedIndex="0">
                                <ComboBoxItem Content="Damage / Defective"/>
                                <ComboBoxItem Content="Expired / Deteriorated"/>
                                <ComboBoxItem Content="Internal Workshop Use"/>
                                <ComboBoxItem Content="Inventory Audit Adjustment"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Adjustment Notes" FontSize="12" Foreground="#8C849C" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtStockOutNotes" Height="36" Background="#0F0C15" Foreground="#FFFFFF" BorderBrush="#251F30" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="BtnCancelStockOut_Click" Background="#251F30" Foreground="#8C849C" BorderThickness="0" Height="36" Padding="16,0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Deduct Stock" Click="BtnSaveStockOut_Click" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Height="36" Padding="20,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ── MODAL: CREATE PURCHASE ORDER (CLERK ONLY) ─────────── -->
        <!-- ======================================================== -->
        <Grid x:Name="modalPO" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#16131C" BorderBrush="#352C44" BorderThickness="1" CornerRadius="12" Width="760" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
