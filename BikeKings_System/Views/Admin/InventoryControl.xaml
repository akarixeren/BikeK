                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="All Classes" Tag="All" Click="BtnFilterAnalytics_Click" Height="30" Margin="0,0,6,0" Padding="10,0" Background="#1D1826" Foreground="#CBD5E1" BorderBrush="#2A2236" BorderThickness="1" Cursor="Hand"/>
