<UserControl x:Class="BikeKings_System.Views.Admin.HistoryLogsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#100E15"
             FontFamily="Poppins">

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Title & Count Badge -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Logs" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="lblLogCount" Text="0 log entries found" Foreground="#9C95AD" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- 2. Multi-Filter Toolbar -->
        <Border Grid.Row="1" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 1. Keyword Search -->
                <Border Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Width="220" Padding="10,0" Margin="0,0,10,0">
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="12" TextChanged="FilterChanged"/>
                        <TextBlock Text="🔍 Filter audit logs..." Foreground="#6B667B" FontSize="12" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <!-- 2. Action Type Filter -->
                <ComboBox x:Name="cmbActionFilter" Height="36" Width="140" Background="#110E17" Foreground="#FFFFFF" BorderBrush="#2A2236" Margin="0,0,10,0" SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="All Actions" IsSelected="True"/>
                    <ComboBoxItem Content="LOGIN"/>
                    <ComboBoxItem Content="LOGOUT"/>
                    <ComboBoxItem Content="MAINTENANCE"/>
                    <ComboBoxItem Content="INVENTORY"/>
                    <ComboBoxItem Content="STOCK_IN"/>
                    <ComboBoxItem Content="STOCK_OUT"/>
                    <ComboBoxItem Content="SUPPLIERS"/>
                    <ComboBoxItem Content="PURCHASE_ORDER"/>
                </ComboBox>
                <!-- 3. Role Filter -->
                <ComboBox x:Name="cmbRoleFilter" Height="36" Width="130" Background="#110E17" Foreground="#FFFFFF" BorderBrush="#2A2236" Margin="0,0,10,0" SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="All Roles" IsSelected="True"/>
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Cashier"/>
                    <ComboBoxItem Content="StoreClerk"/>
                </ComboBox>
                <!-- 4. Date Range Filter -->
                <ComboBox x:Name="cmbDateFilter" Height="36" Width="130" Background="#110E17" Foreground="#FFFFFF" BorderBrush="#2A2236" Margin="0,0,10,0" SelectionChanged="CmbDateFilter_SelectionChanged">
                    <ComboBoxItem Content="All Time" IsSelected="True"/>
                    <ComboBoxItem Content="Today"/>
                    <ComboBoxItem Content="Last 7 Days"/>
                    <ComboBoxItem Content="This Month"/>
                    <ComboBoxItem Content="Custom Range"/>
                </ComboBox>
                <!-- Custom Date Range Inputs (Shown when 'Custom Range' selected) -->
                <StackPanel x:Name="pnlCustomDate" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center">
                    <DatePicker x:Name="dpFromDate" Height="34" Width="115" SelectedDateChanged="FilterChanged"/>
                    <TextBlock Text="to" Foreground="#8C849C" VerticalAlignment="Center" Margin="6,0"/>
                    <DatePicker x:Name="dpToDate" Height="34" Width="115" Margin="0,0,10,0" SelectedDateChanged="FilterChanged"/>
                </StackPanel>
                <!-- 5. Reset Filters Button -->
                <Button Click="BtnResetFilters_Click" Content="✕ Clear Filters" Height="36" Padding="12,0" Background="#1E1B29" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#2A2236" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#2A2238"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </Border>

        <!-- 3. Logs Table -->
        <Border Grid.Row="2" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Table Header -->
                    <Border Background="#1C1824" Padding="20,12" BorderBrush="#2A2236" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIMESTAMP" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                            <TextBlock Grid.Column="1" Text="USER" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                            <TextBlock Grid.Column="2" Text="ROLE" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                            <TextBlock Grid.Column="3" Text="ACTION TYPE" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                            <TextBlock Grid.Column="4" Text="DETAILS" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                        </Grid>
                    </Border>

                    <!-- Logs Items -->
                    <ItemsControl x:Name="icLogs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1F1A28" BorderThickness="0,0,0,1" Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" FontSize="12" Foreground="#8C849C" VerticalAlignment="Center"/>

                                        <!-- User -->
                                        <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                        <!-- Role Badge -->
                                        <Border Grid.Column="2" Background="{Binding RoleBgColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RoleBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding RoleTextColor}"/>
                                        </Border>

                                        <!-- Action Type Badge -->
                                        <Border Grid.Column="3" Background="{Binding ActionBgColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActionType}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding ActionTextColor}"/>
                                        </Border>

                                        <!-- Details -->
                                        <TextBlock Grid.Column="4" Text="{Binding Details}" FontSize="12" Foreground="#D1CCE0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>