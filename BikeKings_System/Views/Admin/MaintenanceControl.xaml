<UserControl x:Class="BikeKings_System.Views.Admin.MaintenanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#100E15"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Slim Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2E283D" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ── MAIN SPLIT CARDS ── -->
        <Grid Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <!-- Left Card: Product Master Data -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <!-- Right Card: Services, Mechanics & Staff -->
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- ── LEFT CARD: PRODUCT MASTER DATA (CATEGORIES & BRANDS) ─ -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Card Title -->
                        <RowDefinition Height="*"/>
                        <!-- Categories Section -->
                        <RowDefinition Height="16"/>
                        <!-- Separator -->
                        <RowDefinition Height="*"/>
                        <!-- Brands Section -->
                    </Grid.RowDefinitions>

                    <!-- Left Card Header -->
                    <TextBlock Grid.Row="0" Text="Product Master Data" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                    <!-- SECTION 1: CATEGORIES -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Sub-Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Pinned Add Bar -->
                            <RowDefinition Height="*"/>
                            <!-- Inner Scrollable Items -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Manage Categories" FontSize="11.5" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,8"/>

                        <!-- Add Category Form (Pinned) -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                                <TextBox x:Name="txtCategory" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" FontSize="12"/>
                            </Border>

                            <Button Grid.Column="2" Content="Add" Height="36" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnAddCategory_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Dedicated Scrollable Categories List -->
                        <Border Grid.Row="2" Background="#110E17" BorderBrush="#231B2D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="icCategories">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold" Foreground="#E0DBEC" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="✏️" Height="22" Width="24" Background="#262135" Foreground="#A99ECC" FontSize="10" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Tag="{Binding}" Click="BtnEditCategory_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Content="🗑️" Height="22" Width="24" Background="#3E161C" Foreground="#EF4444" FontSize="10" BorderThickness="0" Cursor="Hand" Tag="{Binding CategoryID}" Click="BtnDeleteCategory_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Separator Grid.Row="2" Background="#251F30" Height="1"/>

                    <!-- SECTION 2: BRANDS -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Sub-Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Pinned Add Bar -->
                            <RowDefinition Height="*"/>
                            <!-- Inner Scrollable Items -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Manage Brands" FontSize="11.5" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,8"/>

                        <!-- Add Brand Form (Pinned) -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                                <TextBox x:Name="txtBrand" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" FontSize="12"/>
                            </Border>

                            <Button Grid.Column="2" Content="Add" Height="36" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnAddBrand_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Dedicated Scrollable Brands List -->
                        <Border Grid.Row="2" Background="#110E17" BorderBrush="#231B2D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="icBrands">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <TextBlock Text="{Binding BrandName}" FontSize="12" FontWeight="SemiBold" Foreground="#E0DBEC" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="✏️" Height="22" Width="24" Background="#262135" Foreground="#A99ECC" FontSize="10" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Tag="{Binding}" Click="BtnEditBrand_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Content="🗑️" Height="22" Width="24" Background="#3E161C" Foreground="#EF4444" FontSize="10" BorderThickness="0" Cursor="Hand" Tag="{Binding BrandID}" Click="BtnDeleteBrand_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- ── RIGHT CARD: SERVICES, MECHANICS & STAFF ACCOUNTS ──── -->
            <!-- ======================================================== -->
            <Border Grid.Column="2" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Card Title -->
                        <RowDefinition Height="1.2*"/>
                        <!-- Services Section -->
                        <RowDefinition Height="12"/>
                        <!-- Separator -->
                        <RowDefinition Height="*"/>
                        <!-- Mechanics Section -->
                        <RowDefinition Height="12"/>
                        <!-- Separator -->
                        <RowDefinition Height="1.1*"/>
                        <!-- Staff Accounts Section -->
                    </Grid.RowDefinitions>

                    <!-- Right Card Header -->
                    <TextBlock Grid.Row="0" Text="Services, Mechanics &amp; Staff" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                    <!-- SECTION 1: REPAIR SERVICES & LABOR FEES -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Sub-Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Pinned Add Bar -->
                            <RowDefinition Height="*"/>
                            <!-- Inner Scrollable Items -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Repair Services &amp; Labor Fees" FontSize="11.5" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,6"/>

                        <!-- Add Service Form (Pinned) -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="75"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                                <TextBox x:Name="txtServiceName" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" FontSize="12"/>
                            </Border>

                            <Border Grid.Column="2" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                                <TextBox x:Name="txtLaborFee" Text="0.00" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" FontSize="12"/>
                            </Border>

                            <Button Grid.Column="4" Content="Add" Height="36" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnAddService_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Dedicated Scrollable Services List -->
                        <Border Grid.Row="2" Background="#110E17" BorderBrush="#231B2D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="icServices">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="65"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ServiceName}" FontSize="12" FontWeight="SemiBold" Foreground="#E0DBEC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedFee}" FontSize="12" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="✏️" Height="22" Width="24" Background="#262135" Foreground="#A99ECC" FontSize="10" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Tag="{Binding}" Click="BtnEditService_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Content="🗑️" Height="22" Width="24" Background="#3E161C" Foreground="#EF4444" FontSize="10" BorderThickness="0" Cursor="Hand" Tag="{Binding ServiceID}" Click="BtnDeleteService_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Separator Grid.Row="2" Background="#251F30" Height="1"/>

                    <!-- SECTION 2: MECHANICS & TECHNICIANS -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Sub-Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Pinned Add Bar -->
                            <RowDefinition Height="*"/>
                            <!-- Inner Scrollable Items -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Manage Mechanics &amp; Technicians" FontSize="11.5" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,6"/>

                        <!-- Add Mechanic Form (Pinned) -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0">
                                <TextBox x:Name="txtMechanic" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" FontSize="12"/>
                            </Border>

                            <Border Grid.Column="2" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="6,0" ToolTip="Commission Rate (%)">
                                <TextBox x:Name="txtMechCommission" Text="80" HorizontalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#10B981" FontWeight="Bold" CaretBrush="#FFFFFF" VerticalAlignment="Center" FontSize="12"/>
                            </Border>

                            <Button Grid.Column="4" Content="Add" Height="36" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnAddMechanic_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Dedicated Scrollable Mechanics List -->
                        <Border Grid.Row="2" Background="#110E17" BorderBrush="#231B2D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="icMechanics">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MechanicName}" FontSize="12" FontWeight="SemiBold" Foreground="#E0DBEC" VerticalAlignment="Center"/>
                                                    <Border Background="#162920" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedCommission}" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="✏️" Height="22" Width="24" Background="#262135" Foreground="#A99ECC" FontSize="10" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Tag="{Binding}" Click="BtnEditMechanic_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Content="🗑️" Height="22" Width="24" Background="#3E161C" Foreground="#EF4444" FontSize="10" BorderThickness="0" Cursor="Hand" Tag="{Binding MechanicID}" Click="BtnRemoveMechanic_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Separator Grid.Row="4" Background="#251F30" Height="1"/>

                    <!-- SECTION 3: SYSTEM USER ACCOUNTS -->
                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Sub-Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Create User Action Button -->
                            <RowDefinition Height="*"/>
                            <!-- Inner Scrollable Staff List -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="System User Accounts (Login Credentials)" FontSize="11.5" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,6"/>

                        <!-- Create User Button (Pinned) -->
                        <Button Grid.Row="1" Height="36" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" Cursor="Hand" Margin="0,0,0,8" Click="BtnCreateUser_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="👤 " FontSize="12"/>
                                            <TextBlock Text="Create User Account (Admin / Cashier / Clerk)" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Dedicated Scrollable Staff List -->
                        <Border Grid.Row="2" Background="#110E17" BorderBrush="#231B2D" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="icStaff">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{Binding RoleText}" FontSize="10" Foreground="#8C849C" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button Content="Remove" Height="24" Padding="8,0" Background="#3A151D" Foreground="#FF7D91" FontSize="10" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Tag="{Binding UserID}" Click="BtnRemoveUser_Click" Visibility="{Binding RemoveVisibility}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- ── EDIT ITEM MODAL OVERLAY ───────────────────────────── -->
        <!-- ======================================================== -->
        <Grid x:Name="modalEditItem" Visibility="Collapsed" Background="#C80A0810">
            <Border Background="#16131C" BorderBrush="#2E283D" BorderThickness="1" CornerRadius="12" Width="440" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="lblEditModalTitle" Text="Edit Maintenance Item" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                    <TextBlock Text="Name / Title" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                    <Border Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0" Margin="0,0,0,14">
                        <TextBox x:Name="txtEditName" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Extra Field for Services Labor Fee -->
                    <StackPanel x:Name="pnlEditServiceFee" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Labor Fee (₱)" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                        <Border Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                            <TextBox x:Name="txtEditFee" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Extra Field for Mechanic Commission % -->
                    <StackPanel x:Name="pnlEditMechCommission" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="Commission Rate (%)" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                        <Border Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                            <TextBox x:Name="txtEditCommission" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Height="34" Padding="16,0" Background="#241E30" Foreground="#BDB7CC" FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnCloseEditModal_Click"/>
                        <Button Content="Save Changes" Height="34" Padding="18,0" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="BtnSaveEditModal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>