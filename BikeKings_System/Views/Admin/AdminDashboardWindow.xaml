<Window x:Class="BikeKings_System.Views.Admin.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:admin="clr-namespace:BikeKings_System.Views.Admin"
        Title="Bike Kings Cycle &amp; Motor Repair - Admin Dashboard"
        Height="880" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0F0C15">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- ── 1. DARK SIDEBAR ───────────────────────────────────── -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="#16131C" BorderBrush="#251F30" BorderThickness="0,0,1,0" Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BIKE KINGS" FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="CYCLE &amp; MOTOR REPAIR" FontSize="9.5" FontWeight="Bold" Foreground="#E63956" Margin="28,2,0,0"/>
                </StackPanel>

                <!-- User Profile Card -->
                <Border Grid.Row="1" Background="#110E17" CornerRadius="10" Padding="12" Margin="0,0,0,20" BorderBrush="#251F30" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="UserProfile_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#2A1B28" BorderBrush="#E63956" BorderThickness="1">
                            <TextBlock x:Name="lblAvatarInitial" Text="A" Foreground="#E63956" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblUserName" Text="Administrator" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                            <Border Background="#2A1B28" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock Text="ADMINISTRATOR" Foreground="#E63956" FontWeight="Bold" FontSize="8.5"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="pnlNavMenu">
                        <TextBlock Text="CORE SYSTEM" Foreground="#5E586E" FontWeight="Bold" FontSize="9.5" Margin="8,0,0,10"/>

                        <!-- Dashboard -->
                        <Button x:Name="navDashboard" Click="Nav_Click" Height="40" Margin="0,0,0,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBdr" Background="#E63956" CornerRadius="8" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📊" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="btnTxt" Text="Dashboard" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Sales & Job Orders -->
                        <Button x:Name="navSales" Click="Nav_Click" Height="40" Margin="0,0,0,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBdr" Background="Transparent" CornerRadius="8" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💳" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="btnTxt" Text="Sales &amp; Job Orders" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Inventory -->
                        <Button x:Name="navInventory" Click="Nav_Click" Height="40" Margin="0,0,0,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBdr" Background="Transparent" CornerRadius="8" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📦" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="btnTxt" Text="Inventory" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Suppliers -->
                        <Button x:Name="navSuppliers" Click="Nav_Click" Height="40" Margin="0,0,0,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBdr" Background="Transparent" CornerRadius="8" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🚚" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="btnTxt" Text="Suppliers" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="ADMINISTRATION" Foreground="#5E586E" FontWeight="Bold" FontSize="9.5" Margin="8,16,0,10"/>

                        <!-- History Logs -->
                        <Button x:Name="navLogs" Click="Nav_Click" Height="40" Margin="0,0,0,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBdr" Background="Transparent" CornerRadius="8" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📜" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="btnTxt" Text="History Logs" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- System Maintenance -->
                        <Button x:Name="navMaintenance" Click="Nav_Click" Height="40" Margin="0,0,0,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBdr" Background="Transparent" CornerRadius="8" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚙️" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="btnTxt" Text="Maintenance" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Backup -->
                        <Button x:Name="navBackup" Click="Nav_Click" Height="40" Margin="0,0,0,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBdr" Background="Transparent" CornerRadius="8" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💾" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="btnTxt" Text="Backup &amp; Restore" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Profile Button for click handler -->
                        <Button x:Name="navProfile" Click="Nav_Click" Height="40" Margin="0,0,0,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBdr" Background="Transparent" CornerRadius="8" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👤" FontSize="13" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="btnTxt" Text="My Profile" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logout Button -->
                <Button Grid.Row="3" Click="BtnLogout_Click" Background="#24141B" Foreground="#FDA4AF" BorderBrush="#541B28" BorderThickness="1" Height="38" Margin="0,16,0,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚪" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Log Out" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ── 2. TOP HEADER & MAIN VIEWS CONTAINER ──────────────── -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top App Bar -->
            <Border Grid.Row="0" Background="#131019" BorderBrush="#251F30" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblHeaderTitle" Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="lblDateTime" Text="Live Clock..." FontSize="11.5" Foreground="#787189" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Header Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="pnlStockAlertBadge" Background="#1D2A20" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" Cursor="Hand" MouseLeftButtonDown="NotificationBadge_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="lblStockStatus" Text="✅ Normal Levels" FontSize="11.5" FontWeight="SemiBold" Foreground="#2ECC71"/>
                                <Border Background="#2A1B28" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                    <TextBlock x:Name="lblNotifBadge" Text="0 ALERTS" FontSize="9.5" FontWeight="Bold" Foreground="#2ECC71"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button Click="BtnExport_Click" Content="📥 Export CSV" Background="#221C2B" Foreground="#E2E8F0" BorderBrush="#352C44" BorderThickness="1" Height="34" Padding="14,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Views Container -->
            <Grid Grid.Row="1">

                <!-- VIEW 1: DASHBOARD (NON-SCROLLABLE FULL-VIEW FIT) -->
                <Grid x:Name="pnlDashboardView" Margin="24,14,24,14" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Period Switcher -->
                    <Border Grid.Row="0" Background="#16131C" CornerRadius="10" BorderBrush="#251F30" BorderThickness="1" Padding="14,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border x:Name="btnPeriodDaily" Tag="Daily" MouseLeftButtonDown="Period_Click" Background="#E63956" CornerRadius="6" Padding="14,6" Margin="0,0,6,0" Cursor="Hand">
                                    <TextBlock x:Name="txtDaily" Text="Daily" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border x:Name="btnPeriodWeekly" Tag="Weekly" MouseLeftButtonDown="Period_Click" Background="#1D1826" CornerRadius="6" Padding="14,6" Margin="0,0,6,0" Cursor="Hand">
                                    <TextBlock x:Name="txtWeekly" Text="Weekly" Foreground="#8C849C" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border x:Name="btnPeriodMonthly" Tag="Monthly" MouseLeftButtonDown="Period_Click" Background="#1D1826" CornerRadius="6" Padding="14,6" Margin="0,0,6,0" Cursor="Hand">
                                    <TextBlock x:Name="txtMonthly" Text="Monthly" Foreground="#8C849C" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border x:Name="btnPeriodAnnual" Tag="Annually" MouseLeftButtonDown="Period_Click" Background="#1D1826" CornerRadius="6" Padding="14,6" Margin="0,0,6,0" Cursor="Hand">
                                    <TextBlock x:Name="txtAnnual" Text="Annually" Foreground="#8C849C" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="lblPeriodSub" Grid.Column="1" Text="Here are today's sales &amp; service stats for Bike Kings Cycle Center" Foreground="#787189" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <DatePicker x:Name="dpFromDate" Width="110" Height="28" Margin="0,0,6,0"/>
                                <TextBlock Text="to" Foreground="#787189" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="dpToDate" Width="110" Height="28" Margin="0,0,8,0"/>
                                <Button Content="Apply" Click="BtnApplyDate_Click" Background="#E63956" Foreground="#FFFFFF" Height="28" Padding="10,0" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="Reset" Click="BtnResetDate_Click" Background="#251F30" Foreground="#E2E8F0" Height="28" Padding="10,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: 4 Summary KPI Cards -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="KpiRevenue_Click">
                            <StackPanel>
                                <TextBlock x:Name="lblRevenueSub" Text="Daily Revenue" FontSize="11" Foreground="#787189"/>
                                <TextBlock x:Name="lblTotalRevenue" Text="₱0.00" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                <TextBlock Text="Click to view sales ledger" FontSize="10" Foreground="#38BDF8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="3,0,3,0" Cursor="Hand" MouseLeftButtonDown="KpiProfit_Click">
                            <StackPanel>
                                <TextBlock Text="Gross Profit" FontSize="11" Foreground="#787189"/>
                                <TextBlock x:Name="lblGrossProfit" Text="₱0.00" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                <TextBlock x:Name="lblMargin" Text="0% Margin" FontSize="10" Foreground="#86EFAC" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="3,0,3,0" Cursor="Hand" MouseLeftButtonDown="KpiTransactions_Click">
                            <StackPanel>
                                <TextBlock Text="Completed Orders" FontSize="11" Foreground="#787189"/>
                                <TextBlock x:Name="lblTransactions" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                                <TextBlock Text="POS &amp; Completed Job Orders" FontSize="10" Foreground="#787189" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="KpiStock_Click">
                            <StackPanel>
                                <TextBlock Text="Low / Critical Stock" FontSize="11" Foreground="#787189"/>
                                <TextBlock x:Name="lblLowStockCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#F43F5E" Margin="0,4,0,0"/>
                                <TextBlock Text="Click to jump to replenishment" FontSize="10" Foreground="#FDA4AF" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Row 2: Sales Trend & Category Breakdown -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sales Trend Chart -->
                        <Border Grid.Column="0" Background="#16131C" CornerRadius="10" BorderBrush="#251F30" BorderThickness="1" Padding="18,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Sales &amp; Service Revenue Trend" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="lblChartPeriod" Text="Period: DAILY" FontSize="10.5" Foreground="#5E586E" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="lblChartStatus" Text="Completed Orders" FontSize="11" Foreground="#787189" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>

                                <!-- Proper Upright Chart Canvas -->
                                <ItemsControl x:Name="chartBarsControl" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Bottom" Margin="10,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!-- Top Value Label -->
                                                <TextBlock Grid.Row="0" Text="{Binding FormattedRevenue}" FontSize="9.5" Foreground="#A5B4FC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                
                                                <!-- Upright Bar standing from bottom -->
                                                <Border Grid.Row="1" Width="{Binding BarWidth}" Height="{Binding BarHeightPixels}" Background="#E63956" CornerRadius="4,4,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                                
                                                <!-- Bottom Category / Date Label -->
                                                <TextBlock Grid.Row="2" Text="{Binding DayLabel}" FontSize="10" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Revenue by Category -->
                        <Border Grid.Column="2" Background="#16131C" CornerRadius="10" BorderBrush="#251F30" BorderThickness="1" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="Revenue by Category" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="icTopCategories">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#110E17" CornerRadius="6" Padding="12,6" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="CategoryItem_Click" Tag="{Binding CategoryName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding CategoryName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedRevenue}" Foreground="#10B981" FontWeight="Bold" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 3: Stock Alert Watchlist & Mechanic Productivity -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Critical Stock Alerts -->
                        <Border Grid.Column="0" Background="#16131C" CornerRadius="10" BorderBrush="#251F30" BorderThickness="1" Padding="18,12">
                            <StackPanel>
                                <TextBlock Text="Critical Stock Alerts" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="icStockAlerts">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#110E17" CornerRadius="6" Padding="12,6" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="OpenProductModalFromItem_Click" Tag="{Binding SkuText}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProductName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5"/>
                                                        <TextBlock Text="{Binding SkuText}" Foreground="#787189" FontSize="10" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeFg}" FontWeight="Bold" FontSize="9.5"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Mechanic Performance & Commission -->
                        <Border Grid.Column="2" Background="#16131C" CornerRadius="10" BorderBrush="#251F30" BorderThickness="1" Padding="18,12">
                            <StackPanel>
                                <TextBlock Text="Mechanic Performance &amp; Commission" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="icMechanicProductivity">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#110E17" CornerRadius="6" Padding="12,6" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="OpenMechanicModal_Click" Tag="{Binding MechanicName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MechanicName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5"/>
                                                        <TextBlock Text="{Binding FormattedJobs}" Foreground="#787189" FontSize="10" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock Text="Labor: " Foreground="#787189" FontSize="10"/>
                                                            <TextBlock Text="{Binding FormattedLabor}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                            <TextBlock Text="Earned: " Foreground="#10B981" FontSize="9.5" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding FormattedCommission}" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>

                <!-- VIEW 2: SALES & JOB ORDERS -->
                <admin:SalesOrdersControl x:Name="pnlSalesView" Visibility="Collapsed"/>

                <!-- VIEW 3: INVENTORY CONTROL -->
                <admin:InventoryControl x:Name="pnlInventoryView" Visibility="Collapsed"/>

                <!-- VIEW 4: SUPPLIERS -->
                <admin:SuppliersControl x:Name="pnlSuppliersView" Visibility="Collapsed"/>

                <!-- VIEW 5: HISTORY LOGS -->
                <admin:HistoryLogsControl x:Name="pnlLogsView" Visibility="Collapsed"/>

                <!-- VIEW 6: MAINTENANCE -->
                <admin:MaintenanceControl x:Name="pnlMaintenanceView" Visibility="Collapsed"/>

                <!-- VIEW 7: BACKUP & RECOVERY -->
                <admin:BackupRecoveryControl x:Name="pnlBackupView" Visibility="Collapsed"/>
                
                <!--VIEW 8: PROFILE -->
                <admin:ProfileControl x:Name="pnlProfileView" Visibility="Collapsed"/>

            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- ── 3. MODALS & POPUP OVERLAYS ────────────────────────── -->
        <!-- ======================================================== -->

        <Grid x:Name="modalOverlay" Grid.ColumnSpan="2" Background="#CC000000" Visibility="Collapsed">

            <Border x:Name="modalMechanic" Background="#16131C" BorderBrush="#352C44" BorderThickness="1" CornerRadius="12" Width="580" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="lblModalMechTitle" Text="Mechanic Earnings &amp; Performance" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="lblModalMechPeriod" Text="Cutoff Period: All Time" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Click="CloseModal_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="#8C849C" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <!-- Summary KPI Cards -->
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <Border Background="#100C16" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="JOBS COMPLETED" FontSize="10" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="lblModalMechJobs" Text="0 jobs" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#100C16" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL LABOR REVENUE" FontSize="10" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="lblModalMechLabor" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border Background="#0E2A1E" BorderBrush="#1C4B36" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="lblModalMechPayoutTitle" Text="MECHANIC EARNINGS (PAYOUT)" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                <TextBlock x:Name="lblModalMechComm" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#100C16" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="lblModalShopShareTitle" Text="SHOP SHARE (RETAINED)" FontSize="10" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="lblModalMechShopShare" Text="₱0.00" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Itemized Job Breakdown -->
                    <TextBlock Text="Itemized Cutoff Job Breakdown" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtModalMechNoJobs" Text="No completed service jobs recorded in this period." Foreground="#787189" FontSize="11.5" Visibility="Collapsed" Margin="0,0,0,10"/>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl x:Name="icModalMechJobs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#110E17" BorderBrush="#201A29" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="ModalJobOrder_Click" Tag="{Binding JobOrderNo}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding JobOrderNo}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5"/>
                                                    <TextBlock Text="{Binding FormattedDate}" Foreground="#8C849C" FontSize="10.5" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding CustomerVehicle}" Foreground="#8C849C" FontSize="10.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedComm}" Foreground="#10B981" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding FormattedLabor, StringFormat='Labor: {0}'}" Foreground="#787189" FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <Grid>
                        <Button Content="📄 Export Pay Slip" Click="BtnExportMechPaySlip_Click" Background="#1D283A" Foreground="#38BDF8" BorderBrush="#253A5A" BorderThickness="1" Height="34" Padding="14,0" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Left" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Close" Click="CloseModal_Click" Background="#251F30" Foreground="#E2E8F0" Height="34" Padding="16,0" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="View in Sales" Click="BtnViewMechInSales_Click" Background="#E63956" Foreground="#FFFFFF" FontWeight="SemiBold" Height="34" Padding="16,0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="modalProduct" Background="#16131C" BorderBrush="#352C44" BorderThickness="1" CornerRadius="12" Width="450" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Product Stock Info" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                    <TextBlock x:Name="lblModalProdSku" Text="SKU-000" FontSize="13" Foreground="#38BDF8" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Click="CloseModal_Click" Background="#251F30" Foreground="#E2E8F0" Height="34" Padding="16,0" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Content="Go to Inventory" Click="BtnGoToInventory_Click" Background="#E63956" Foreground="#FFFFFF" FontWeight="SemiBold" Height="34" Padding="18,0" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Notification Dropdown -->
        <Border x:Name="dropdownNotification" Grid.Column="1" Width="380" Background="#16131C" BorderBrush="#352C44" BorderThickness="1" CornerRadius="10" Padding="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,24,0" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Inventory Alerts" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <Button Click="BtnCloseNotifDropdown_Click" Content="✕" Background="Transparent" Foreground="#787189" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"/>
                </Grid>
                <TextBlock x:Name="lblNotifDropdownSubtitle" Text="Checking alerts..." FontSize="11" Foreground="#787189" Margin="0,0,0,12"/>
                <TextBlock x:Name="pnlNotifEmpty" Text="✅ All products are well-stocked!" Foreground="#10B981" FontSize="12" Visibility="Collapsed" Margin="0,0,0,12"/>

                <!-- Scrollable Alert Items List -->
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="icDropdownAlerts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#110E17" CornerRadius="6" Padding="10,8" Margin="0,0,6,6" Cursor="Hand" MouseLeftButtonDown="NotifItem_Click" Tag="{Binding SKU}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SKU}" Foreground="#787189" FontSize="10"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StockStatus}" Foreground="{Binding StatusFgColor}" FontWeight="Bold" FontSize="9.5"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="View Inventory" Click="BtnNotifGoToMasterlist_Click" Background="#251F30" Foreground="#E2E8F0" Height="28" Padding="12,0" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                    <Button Content="Create PO" Click="BtnNotifCreatePO_Click" Background="#E63956" Foreground="#FFFFFF" FontWeight="SemiBold" Height="28" Padding="12,0" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>