<Window x:Class="BikeKings_System.Views.Admin.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Create User Account" 
        Width="480" 
        MinHeight="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#100E15"
        FontFamily="Segoe UI">

    <Border Background="#16131C" CornerRadius="12" Margin="16" Padding="24" BorderBrush="#251F30" BorderThickness="1">
        <StackPanel>
            <!-- Title -->
            <TextBlock Text="Create New Staff Account" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
            <TextBlock Text="Add a new operator to the system with designated access permissions" FontSize="12" Foreground="#8C849C" Margin="0,0,0,20"/>

            <!-- Full Name -->
            <TextBlock Text="Full Name *" FontSize="12" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,6"/>
            <Border Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="38" Padding="10,0" Margin="0,0,0,16">
                <TextBox x:Name="txtFullName" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF" BorderThickness="0" VerticalAlignment="Center" FontSize="13"/>
            </Border>

            <!-- Username -->
            <TextBlock Text="Username *" FontSize="12" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,6"/>
            <Border Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="38" Padding="10,0" Margin="0,0,0,16">
                <TextBox x:Name="txtUsername" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF" BorderThickness="0" VerticalAlignment="Center" FontSize="13"/>
            </Border>

            <!-- Password with Eye Toggle -->
            <TextBlock Text="Password *" FontSize="12" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hidden PasswordBox -->
                <Border Grid.Column="0" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="38" Padding="10,0">
                    <PasswordBox x:Name="txtPassword" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF" BorderThickness="0" VerticalAlignment="Center" FontSize="13"/>
                </Border>

                <!-- Visible TextBox for Eye Reveal -->
                <Border Grid.Column="0" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="38" Padding="10,0" x:Name="borderVisiblePassword">
                    <TextBox x:Name="txtPasswordRevealed" Background="Transparent" Foreground="#FFFFFF" CaretBrush="#FFFFFF" BorderThickness="0" VerticalAlignment="Center" FontSize="13" Visibility="Collapsed"/>
                </Border>

                <!-- Eye Toggle Button -->
                <Button x:Name="btnTogglePassword" Grid.Column="1" Width="40" Height="38" Margin="8,0,0,0"
                        Content="👁" FontSize="14" Background="#1D1826" Foreground="#9C95AD"
                        BorderBrush="#2A2236" BorderThickness="1" Cursor="Hand"
                        Click="BtnTogglePw_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Role Selector -->
            <TextBlock Text="Role / Access Level *" FontSize="12" FontWeight="SemiBold" Foreground="#9C95AD" Margin="0,0,0,6"/>
            <ComboBox x:Name="cbRole" Height="38" Background="#110E17" Foreground="#000000"
                      BorderBrush="#2A2236" BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"
                      FontSize="13" Margin="0,0,0,24">
                <ComboBoxItem Content="Admin" IsSelected="True"/>
                <ComboBoxItem Content="Cashier"/>
                <ComboBoxItem Content="StoreClerk"/>
            </ComboBox>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel" Height="38" Background="#241E30" Foreground="#BDB7CC"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Create Account" Height="38" Background="#E63956" Foreground="#FFFFFF"
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>