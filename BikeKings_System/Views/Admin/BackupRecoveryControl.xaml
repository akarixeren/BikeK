<UserControl x:Class="BikeKings_System.Views.Admin.BackupRecoveryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="Transparent">

    <Grid>
        <!-- Centered Backup & Recovery Card -->
        <Border Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#16131C"
                BorderBrush="#251F30"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.6" Direction="270" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Crimson Header Banner -->
                <Border Grid.Row="0" Background="#E63956" CornerRadius="13,13,0,0" Padding="20,14">
                    <TextBlock Text="Database Backup and Recovery" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                </Border>

                <!-- Card Content Body -->
                <StackPanel Grid.Row="1" Margin="36,30,36,30" HorizontalAlignment="Stretch">

                    <!-- Crimson Cloud Upload Icon -->
                    <Border Width="80" Height="80" CornerRadius="40" Background="#261622" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M 19.35 10.04 C 18.67 6.59 15.64 4 12 4 C 9.11 4 6.6 5.64 5.35 8.04 C 2.34 8.36 0 10.91 0 14 C 0 17.31 2.69 20 6 20 L 19 20 C 21.76 20 24 17.76 24 15 C 24 12.36 21.95 10.22 19.35 10.04 Z M 14 13 L 14 17 L 10 17 L 10 13 L 7 13 L 12 8 L 17 13 L 14 13 Z"
                              Fill="#E63956"
                              Stretch="Uniform"
                              Width="44"
                              Height="44"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Secure Local Backup" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Subtitle Description -->
                    <TextBlock Text="Export your entire computerized database (products, inventory, suppliers, sales records, job orders, and system logs) to a local file."
                               Foreground="#8C849C"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="440"
                               LineHeight="18"
                               Margin="0,0,0,24"
                               HorizontalAlignment="Center"/>

                    <!-- Live Progress Feedback -->
                    <ProgressBar x:Name="pbProgress" IsIndeterminate="True" Height="4" Background="#110E17" Foreground="#E63956" Margin="0,0,0,14" Visibility="Collapsed"/>
                    <TextBlock x:Name="lblStatus" Text="" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- Primary Crimson Button: Backup Database -->
                    <Button x:Name="btnBackup" Click="BtnBackup_Click" Height="44" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Backup Database" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#FF4D6D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Secondary Dark Button with Amber Border: Restore from Backup -->
                    <Button x:Name="btnRestore" Click="BtnRestore_Click" Height="44" Background="#110E17" BorderBrush="#D97706" BorderThickness="1" Foreground="#F59E0B" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,0,20">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="↺" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Restore from Backup" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#251C12"/>
                                        <Setter TargetName="bdr" Property="BorderBrush" Value="#FBBF24"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Note Info Box -->
                    <Border Background="#0C1B26" BorderBrush="#0369A1" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ℹ" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="Note: System records are stored locally at Documents/BikeKings/bike_kings_db.bak. Backups should be saved on separate storage/flash drives weekly."
                                       Foreground="#38BDF8" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>