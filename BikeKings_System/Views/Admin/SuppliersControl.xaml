<UserControl x:Class="BikeKings_System.Views.Admin.SuppliersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#100E15"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- DataGrid Header Style matching Sales & Inventory -->
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1C1824"/>
            <Setter Property="Foreground" Value="#8C849C"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#2A2236"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- DataGrid Row Style matching Sales & Inventory -->
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1F1A28"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C1726"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A1E33"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP SUPPLIER KPI CARDS -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Active Suppliers -->
            <Border Grid.Column="0" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="ACTIVE SUPPLIER PARTNERS" FontSize="10" FontWeight="Bold" Foreground="#8C849C"/>
                    <TextBlock x:Name="lblActiveSuppliers" Text="0 Active Partners" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,6,0,0"/>
                    <TextBlock Text="Verified distributors &amp; manufacturers" FontSize="10" Foreground="#7E768C" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Active Procurement Orders -->
            <Border Grid.Column="2" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="ACTIVE PURCHASE ORDERS" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                    <TextBlock x:Name="lblActivePOCount" Text="0 Pending Orders" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" Margin="0,6,0,0"/>
                    <TextBlock x:Name="lblActivePOValue" Text="₱0.00 pending procurement" FontSize="10" Foreground="#7E768C" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Total Supplied Catalog Items -->
            <Border Grid.Column="4" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="SUPPLIED PRODUCT CATALOG" FontSize="10" FontWeight="Bold" Foreground="#2ECC71"/>
                    <TextBlock x:Name="lblTotalCatalogItems" Text="0 Catalog SKUs" FontSize="20" FontWeight="Bold" Foreground="#2ECC71" Margin="0,6,0,0"/>
                    <TextBlock Text="Mapped to inventory stock" FontSize="10" Foreground="#7E768C" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Search & Action Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" Background="#16131C" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0" Margin="0,0,14,0">
                <Grid VerticalAlignment="Center">
                    <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="12" TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock Text="🔍 Search supplier company, contact person, phone, or address..." Foreground="#6B667B" FontSize="12" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Export CSV Button -->
            <Button Grid.Column="1" Content="📥 Export CSV" Height="36" Padding="14,0" Background="#1D1826" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="11.5" BorderBrush="#2A2236" BorderThickness="1" Cursor="Hand" Margin="0,0,10,0" Click="BtnExportSuppliers_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Add Supplier Button -->
            <Button Grid.Column="2" Content="+ Add Supplier" Height="36" Padding="18,0" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnAddSupplier_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- 3. Screen-Fitted Suppliers DataGrid (Click or Double-Click Anywhere to View Details) -->
        <Border Grid.Row="2" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="dgSuppliers" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      CanUserResizeColumns="False"
                      CanUserSortColumns="False"
                      IsReadOnly="True" 
                      GridLinesVisibility="None"
                      HeadersVisibility="Column" 
                      RowHeaderWidth="0"
                      SelectionMode="Single" 
                      SelectionUnit="FullRow" 
                      PreviewMouseLeftButtonUp="DgSuppliers_PreviewMouseLeftButtonUp"
                      MouseDoubleClick="DgSuppliers_MouseDoubleClick"
                      Background="Transparent" 
                      BorderThickness="0" 
                      ColumnHeaderStyle="{StaticResource HeaderStyle}" 
                      RowStyle="{StaticResource RowStyle}" 
                      CellStyle="{StaticResource CellStyle}">
                <DataGrid.Columns>
                    <!-- 1. Company Name -->
                    <DataGridTemplateColumn Header="COMPANY NAME" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SupplierName}" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 2. Contact Person -->
                    <DataGridTemplateColumn Header="CONTACT PERSON" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ContactPerson}" Foreground="#D1CCE0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 3. Phone (Uniformly Formatted) -->
                    <DataGridTemplateColumn Header="PHONE" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PhoneFormatted}" Foreground="#60A5FA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 4. Email -->
                    <DataGridTemplateColumn Header="EMAIL" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Email}" Foreground="#9C95AD" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 5. Address -->
                    <DataGridTemplateColumn Header="ADDRESS" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Address}" Foreground="#9C95AD" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 6. Status -->
                    <DataGridTemplateColumn Header="STATUS" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StatusTextColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 7. Actions -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="185">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Catalog Items Button -->
                                    <Button Content="📦 Catalog" Click="BtnViewSuppliedItems_Click" Tag="{Binding}" Background="#0F2838" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" Padding="8,4" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Edit Button -->
                                    <Button Content="✏️ Edit" Click="BtnEditSupplier_Click" Tag="{Binding}" Background="#241E30" Foreground="#D1CCE0" FontSize="10.5" FontWeight="SemiBold" Padding="8,4" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- Status Toggle Button -->
                                    <Button Content="{Binding ToggleActionText}" Click="BtnToggleStatus_Click" Tag="{Binding}" FontSize="10.5" FontWeight="Bold" Padding="8,4" BorderThickness="0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#2D1214"/>
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#0E2A1E"/>
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================================================================= -->
        <!-- ── MODAL 1: SUPPLIER DETAILS 360° PROFILE MODAL ───────────────── -->
        <!-- ================================================================= -->
        <Grid x:Name="modalSupplierDetails" Grid.RowSpan="3" Visibility="Collapsed" Background="#C80A0810">
            <Border Background="#16131C" BorderBrush="#2E283D" BorderThickness="1" CornerRadius="12" Width="820" MaxHeight="680" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Header (Crisp Vector Glyph) -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#60A5FA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="detailSupplierTitle" Text="Supplier Company Name" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="detailStatusBadge" Background="#0E2A1E" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="detailStatusText" Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>
                        <Button Content="✕" Click="BtnCloseSupplierDetails_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#8C849C" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                    </Grid>

                    <!-- Vendor Contact Cards Grid -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="CONTACT PERSON" FontSize="9.5" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="detailContactPerson" Text="Not Specified" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="PHONE NUMBER" FontSize="9.5" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="detailPhone" Text="No phone recorded" FontSize="12.5" FontWeight="Bold" Foreground="#60A5FA" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="EMAIL ADDRESS" FontSize="9.5" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="detailEmail" Text="No email provided" FontSize="12" FontWeight="SemiBold" Foreground="#D1CCE0" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="OFFICE / LOCATION" FontSize="9.5" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="detailAddress" Text="No address registered" FontSize="12" FontWeight="SemiBold" Foreground="#D1CCE0" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Procurement Lifetime Stats -->
                    <Border Grid.Row="2" Background="#1B1724" BorderBrush="#2C233B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOTAL PURCHASE ORDERS" FontSize="10" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="detailTotalPOs" Text="0 Orders" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="LIFETIME PROCUREMENT SPEND" FontSize="10" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="detailTotalSpend" Text="₱0.00" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PENDING DELIVERIES / ORDERS" FontSize="10" FontWeight="Bold" Foreground="#8C849C"/>
                                <TextBlock x:Name="detailPendingPOs" Text="0 Orders Awaiting" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Purchase Orders History Table (Clean No-Overlap Box) -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#60A5FA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Purchase Orders History with this Supplier" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="6" MinHeight="110" MaxHeight="220">
                            <Grid>
                                <DataGrid x:Name="dgSupplierPOs" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="None" HeadersVisibility="Column" RowHeaderWidth="0" Background="Transparent" BorderThickness="0" ColumnHeaderStyle="{StaticResource HeaderStyle}" RowStyle="{StaticResource RowStyle}" CellStyle="{StaticResource CellStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PO NUMBER" Binding="{Binding PONumber}" FontWeight="Bold" Foreground="#60A5FA" Width="140"/>
                                        <DataGridTextColumn Header="ORDER DATE" Binding="{Binding PODate, StringFormat=yyyy-MM-dd}" Foreground="#D1CCE0" Width="120"/>
                                        <DataGridTextColumn Header="TOTAL AMOUNT" Binding="{Binding TotalAmount, StringFormat=₱{0:N2}}" FontWeight="Bold" Foreground="#FFFFFF" Width="130"/>
                                        <DataGridTemplateColumn Header="STATUS" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="REQUESTER" Binding="{Binding RequesterName}" Foreground="#8C849C" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Clean centered empty placeholder when no POs exist (Crisp Vector Icon) -->
                                <StackPanel x:Name="pnlNoPOsNotice" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="20">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="No purchase orders recorded with this supplier yet." Foreground="#8C849C" FontSize="11.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="✏️ Edit Profile" Click="BtnEditFromDetails_Click" Height="34" Padding="16,0" Background="#241E30" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Close" Click="BtnCloseSupplierDetails_Click" Height="34" Padding="20,0" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ── MODAL 2: ADD / EDIT SUPPLIER ───────────────────────────────── -->
        <!-- ================================================================= -->
        <Grid x:Name="modalSupplier" Grid.RowSpan="3" Visibility="Collapsed" Background="#C80A0810">
            <Border Background="#16131C" BorderBrush="#2E283D" BorderThickness="1" CornerRadius="12" Width="510" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="lblSupplierModalTitle" Text="Add Supplier Record" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                    <!-- Company Name -->
                    <TextBlock Text="Company Name *" FontSize="11" Foreground="#8C849C" Margin="0,0,0,4"/>
                    <Border x:Name="bdrModalName" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0" Margin="0,0,0,2">
                        <TextBox x:Name="txtModalName" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" TextChanged="TxtModalInput_TextChanged"/>
                    </Border>
                    <TextBlock x:Name="errModalName" Text="Company name must be at least 2 characters." FontSize="10" Foreground="#F87171" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Contact Person -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Contact Person" FontSize="11" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrModalContact" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                                <TextBox x:Name="txtModalContact" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" TextChanged="TxtModalInput_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="errModalContact" Text="Valid name format required." FontSize="10" Foreground="#F87171" Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Phone Number (Numbers Only, MaxLength 11) -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phone Number *" FontSize="11" Foreground="#8C849C" Margin="0,0,0,4"/>
                            <Border x:Name="bdrModalPhone" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0">
                                <TextBox x:Name="txtModalPhone" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" MaxLength="11" PreviewTextInput="TxtPhone_PreviewTextInput" TextChanged="TxtModalInput_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="errModalPhone" Text="Enter 11-digit mobile (e.g. 09171234567)." FontSize="10" Foreground="#F87171" Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Email Address -->
                    <TextBlock Text="Email Address" FontSize="11" Foreground="#8C849C" Margin="0,8,0,4"/>
                    <Border x:Name="bdrModalEmail" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0" Margin="0,0,0,2">
                        <TextBox x:Name="txtModalEmail" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center" TextChanged="TxtModalInput_TextChanged"/>
                    </Border>
                    <TextBlock x:Name="errModalEmail" Text="Please enter a valid email (e.g., info@supplier.com)." FontSize="10" Foreground="#F87171" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <!-- Address / City -->
                    <TextBlock Text="Address / City" FontSize="11" Foreground="#8C849C" Margin="0,4,0,4"/>
                    <Border x:Name="bdrModalAddress" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,0" Margin="0,0,0,16">
                        <TextBox x:Name="txtModalAddress" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Height="36" Padding="18,0" Background="#241E30" Foreground="#BDB7CC" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnCloseSupplierModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Save Supplier" Height="36" Padding="20,0" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnSaveSupplier_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ── MODAL 3: SUPPLIED ITEMS CATALOG ────────────────────────────── -->
        <!-- ================================================================= -->
        <Grid x:Name="modalSuppliedItems" Grid.RowSpan="3" Visibility="Collapsed" Background="#C80A0810">
            <Border Background="#16131C" BorderBrush="#2E283D" BorderThickness="1" CornerRadius="12" Width="680" MaxHeight="600" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📦 Supplied Catalog Products" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Content="✕" Click="BtnCloseSuppliedItems_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#8C849C" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <TextBlock x:Name="lblSuppliedSupplierName" Grid.Row="1" Text="Supplier Partner: Company" FontSize="12" Foreground="#60A5FA" Margin="0,0,0,16"/>

                    <!-- Catalog Items List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                        <ItemsControl x:Name="icSuppliedProducts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#110E17" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#251F30" BorderThickness="1" Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="SuppliedItemRow_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding SKU}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" Foreground="#7E768C"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat=₱{0:N2}}" FontSize="12" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                            <Border Grid.Column="3" Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StockStatus}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusFgColor}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="Close" Height="34" Padding="20,0" Background="#241E30" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Margin="0,16,0,0" Click="BtnCloseSuppliedItems_Click"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>