<UserControl x:Class="BikeKings_System.Views.Admin.ProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Custom Input Box Style with Rounded Corners & Focus State -->
        <Style x:Key="ProfileInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#110E17"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2236"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bdr" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#E63956"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0F0C15"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#1F1A28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfilePasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#110E17"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2236"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bdr" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#E63956"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,28">
        <Grid.ColumnDefinitions>
            <!-- Left Card: Profile Details -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <!-- Right Card: Account Security -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- ── CARD 1: PROFILE DETAILS ───────────────────────────── -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="14" Padding="32,28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.4" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>
                <!-- Card Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Path Data="M 12 12 c 2.21 0 4 -1.79 4 -4 s -1.79 -4 -4 -4 s -4 1.79 -4 4 s 1.79 4 4 4 z M 12 14 c -2.67 0 -8 1.34 -8 4 v 2 h 16 v -2 c 0 -2.66 -5.33 -4 -8 -4 z" 
                          Fill="#E63956" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Profile Details" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Full Name Field -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="👤" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Full Name" Foreground="#9C95AD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="txtFullName" Style="{StaticResource ProfileInputStyle}"/>
                </StackPanel>

                <!-- Username Field -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="@" FontSize="12" FontWeight="Bold" Foreground="#9C95AD" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Username" Foreground="#9C95AD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="txtUsername" Style="{StaticResource ProfileInputStyle}"/>
                </StackPanel>

                <!-- Assigned Role Field (Read Only) -->
                <StackPanel Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="👥" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Assigned Role" Foreground="#9C95AD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="txtRole" Style="{StaticResource ProfileInputStyle}" IsReadOnly="True" Foreground="#8C849C"/>
                </StackPanel>

                <!-- Update Profile Button -->
                <Button Click="BtnUpdateProfile_Click" Height="44" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Update Profile" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#FF4D6D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ── CARD 2: ACCOUNT SECURITY ──────────────────────────── -->
        <!-- ======================================================== -->
        <Border Grid.Column="2" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="14" Padding="32,28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.4" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>
                <!-- Card Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Path Data="M 18 8 h -1 V 6 c 0 -2.76 -2.24 -5 -5 -5 S 7 3.24 7 6 v 2 H 6 c -1.1 0 -2 0.9 -2 2 v 10 c 0 1.1 0.9 2 2 2 h 12 c 1.1 0 2 -0.9 2 -2 V 10 c 0 -1.1 -0.9 -2 -2 -2 z M 9 6 c 0 -1.66 1.34 -3 3 -3 s 3 1.34 3 3 v 2 H 9 V 6 z" 
                          Fill="#E63956" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Account Security" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Current Password -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔑" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Current Password" Foreground="#9C95AD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <PasswordBox x:Name="txtCurrentPassword" Style="{StaticResource ProfilePasswordStyle}"/>
                </StackPanel>

                <!-- New Password -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="New Password" Foreground="#9C95AD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <PasswordBox x:Name="txtNewPassword" Style="{StaticResource ProfilePasswordStyle}"/>
                </StackPanel>

                <!-- Confirm New Password -->
                <StackPanel Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🛡️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Confirm New Password" Foreground="#9C95AD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <PasswordBox x:Name="txtConfirmPassword" Style="{StaticResource ProfilePasswordStyle}"/>
                </StackPanel>

                <!-- Update Password Button -->
                <Button Click="BtnUpdatePassword_Click" Height="44" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🔑" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Update Password" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#FF4D6D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>