                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#E63956"/>
                                                                        <Setter Property="Background" Value="#1C1826"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="98"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="38"/>
                                                            </Grid.RowDefinitions>
                                                            <!-- Row 0: Photo Container with Badges -->
