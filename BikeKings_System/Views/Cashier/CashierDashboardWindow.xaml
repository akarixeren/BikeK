                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Username" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                                <Border Height="40" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="14,0">
                                    <TextBlock x:Name="lblProfileUsername" Text="cashier" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Assigned Role" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                                <Border Height="40" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="14,0">
                                    <Border Background="#2A1B28" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="CASHIER" FontSize="10" FontWeight="Bold" Foreground="#E63956"/>
                                    </Border>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Account Status" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                                <Border Height="40" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="14,0">
                                    <Border Background="#1D2A20" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="● ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#2ECC71"/>
                                    </Border>
                                </Border>
                            </StackPanel>
