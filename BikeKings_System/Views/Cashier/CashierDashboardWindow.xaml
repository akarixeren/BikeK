                                                <TextBox x:Name="txtSearchProducts" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="12" TextChanged="InvFilter_Changed"/>
                                                <TextBlock x:Name="txtSearchProductsPlaceholder" Text="🔍 Search items by name, SKU, brand, category..." Foreground="#6B667B" FontSize="12" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=txtSearchProducts}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <!-- Quick Filter Chips & Dropdowns -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" x:Name="cmbFilterCategory" Height="32" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID" SelectionChanged="InvFilter_Changed"/>
                                            <ComboBox Grid.Column="2" x:Name="cmbFilterBrand" Height="32" DisplayMemberPath="BrandName" SelectedValuePath="BrandID" SelectionChanged="InvFilter_Changed"/>
                                            <ComboBox Grid.Column="4" x:Name="cmbFilterStockStatus" Height="32" SelectedIndex="0" SelectionChanged="InvFilter_Changed">
                                                <ComboBoxItem Content="All Stock Levels"/>
                                                <ComboBoxItem Content="In Stock Only"/>
                                                <ComboBoxItem Content="Low Stock Alert"/>
                                                <ComboBoxItem Content="Out of Stock"/>
                                            </ComboBox>
                                            <ComboBox Grid.Column="6" x:Name="cmbSortProducts" Height="32" SelectedIndex="0" SelectionChanged="InvFilter_Changed">
                                                <ComboBoxItem Content="Sort: SKU (A-Z)"/>
                                                <ComboBoxItem Content="Sort: Product Name (A-Z)"/>
                                                <ComboBoxItem Content="Sort: In-Stock (Lowest First)"/>
                                                <ComboBoxItem Content="Sort: In-Stock (Highest First)"/>
                                                <ComboBoxItem Content="Sort: Price (Highest First)"/>
                                            </ComboBox>
                                            <Button Grid.Column="8" Content="✕ Clear" Click="BtnClearInvFilters_Click" Height="32" Background="#1D1826" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="11" Padding="14,0" BorderBrush="#2A2236" BorderThickness="1" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <!-- Quick Labor Tray -->
                                    <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ QUICK LABOR:" FontSize="10" FontWeight="Bold" Foreground="#E63956" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="+ Change Oil (₱150)" Height="26" Padding="10,0" Margin="0,0,6,0" Background="#1A1829" Foreground="#60A5FA" BorderBrush="#2F2B48" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Cursor="Hand" Click="BtnQuickLabor_Click" Tag="Change Oil|150"/>
                                                    <Button Content="+ CVT Cleaning (₱250)" Height="26" Padding="10,0" Margin="0,0,6,0" Background="#1A1829" Foreground="#60A5FA" BorderBrush="#2F2B48" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Cursor="Hand" Click="BtnQuickLabor_Click" Tag="CVT Cleaning|250"/>
                                                    <Button Content="+ FI Tune-Up (₱350)" Height="26" Padding="10,0" Margin="0,0,6,0" Background="#1A1829" Foreground="#60A5FA" BorderBrush="#2F2B48" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Cursor="Hand" Click="BtnQuickLabor_Click" Tag="FI Tune-Up|350"/>
                                                    <Button Content="+ Brake Service (₱120)" Height="26" Padding="10,0" Margin="0,0,6,0" Background="#1A1829" Foreground="#60A5FA" BorderBrush="#2F2B48" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Cursor="Hand" Click="BtnQuickLabor_Click" Tag="Brake Service|120"/>
                                                    <Button Content="+ Vulcanizing (₱80)" Height="26" Padding="10,0" Margin="0,0,6,0" Background="#1A1829" Foreground="#60A5FA" BorderBrush="#2F2B48" BorderThickness="1" FontSize="10.5" FontWeight="Bold" Cursor="Hand" Click="BtnQuickLabor_Click" Tag="Vulcanizing|80"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <!-- ══════════════════════════════════════
                                         TOUCHSCREEN PRODUCT PHOTO CARDS GRID
                                    ══════════════════════════════════════ -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                                        <ItemsControl x:Name="icProductsCatalog">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Single Product Card -->
