                                    <PasswordBox x:Name="pbCurrentPassword" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="New Password (min 6 characters):" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                                <Border Height="40" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                    <PasswordBox x:Name="pbNewPassword" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Confirm New Password:" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                                <Border Height="40" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                    <PasswordBox x:Name="pbConfirmPassword" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <Button Height="42" Background="#E63956" BorderThickness="0" Cursor="Hand" Click="BtnUpdatePassword_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="Update Password" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             3. MODALS (RECEIPT & AUDIT REPORTS)
        ══════════════════════════════════════════════════════ -->
        <!-- MODAL 1: OFFICIAL RECEIPT REPRINT SLIP MODAL -->
        <!-- MODAL 1: OFFICIAL RECEIPT (AUTHENTIC BIR-STANDARD SLIP) -->
        <Grid x:Name="modalReceiptOverlay" Grid.ColumnSpan="2" Background="#CC000000" Visibility="Collapsed">
            <Border Width="720" MaxHeight="780" Background="#16131C" BorderBrush="#2E263B" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖩" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Official Sales &amp; Job Order Receipt" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Print-ready authentic Bike Kings cycle &amp; motor repair receipt" FontSize="10" Foreground="#8C849C" Margin="24,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Width="28" Height="28" Background="#241E2F" BorderThickness="0" Cursor="Hand" Click="CloseReceiptModal_Click">
                            <TextBlock Text="✕" FontSize="13" Foreground="#8C849C"/>
                        </Button>
                    </Grid>

                    <!-- Receipt Printable Surface -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border x:Name="pnlPrintSlip" Background="#FFFFFF" CornerRadius="6" Padding="20" TextElement.Foreground="#0F172A">
                            <StackPanel>

                                <!-- Void Watermark (if voided) -->
                                <Border x:Name="pnlVoidWatermark" Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="4" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock Text="⚠️ THIS TRANSACTION HAS BEEN VOIDED / CANCELLED (RESTOCKED TO INVENTORY)" FontWeight="ExtraBold" FontSize="10.5" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- 1. Official Shop Header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BIKE KINGS" FontSize="18" FontWeight="ExtraBold" Foreground="#000000"/>
                                        <TextBlock Text="CYCLE &amp; MOTOR REPAIR SHOP" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,1,0,0"/>
                                        <TextBlock Text="Prop: Richard Allen D. Roque" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,0"/>
                                        <TextBlock Text="NON-VAT Reg. TIN: 254-217-808-00000" FontSize="9" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock Text="Unit 5 JNM Bldg. Don Antonio Heights, Holy Spirit 1127, Quezon City" FontSize="9" Foreground="#64748B"/>
                                        <TextBlock Text="NCR, Second District, Philippines" FontSize="9" Foreground="#64748B"/>
                                    </StackPanel>

                                    <!-- Top Right Invoice Stamp -->
                                    <Border Grid.Column="1" BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="4" Padding="12,8" VerticalAlignment="Top">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="OFFICIAL INVOICE" FontSize="11" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="lblReceiptInvoiceNo" Text="NO: JO-2298" FontSize="12" FontWeight="ExtraBold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            <TextBlock x:Name="lblReceiptDate" Text="Date: Sep 21, 2026 05:51 pm" FontSize="9" Foreground="#475569" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Rectangle Height="1.5" Fill="#0F172A" Margin="0,4,0,10"/>

                                <!-- 2. Sold To & Metadata Cards -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Customer Details -->
                                    <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,8,0" Background="#F8FAFC">
                                        <StackPanel>
                                            <TextBlock Text="SOLD TO / CUSTOMER INFORMATION:" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Customer Name:" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptCustomer" Text="Walk-in Customer" FontSize="10" FontWeight="Bold" Foreground="#0F172A" Margin="95,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Contact Number:" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptContact" Text="N/A" FontSize="9.5" Foreground="#0F172A" Margin="95,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Business Address:" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock Text="Holy Spirit, Quezon City" FontSize="9.5" Foreground="#0F172A" Margin="95,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Service & Order Metadata -->
                                    <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8" Background="#F8FAFC">
                                        <StackPanel>
                                            <TextBlock Text="SERVICE &amp; ORDER METADATA:" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Order Type:" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptType" Text="Job Order" FontSize="9.5" FontWeight="Bold" Foreground="#0F172A" Margin="80,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Unit / Plate:" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptVehicle" Text="Honda Click 125i (123-ABC)" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7" Margin="80,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Mechanic:" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptMechanic" Text="James Morales" FontSize="9.5" Foreground="#0F172A" Margin="80,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,1">
                                                <TextBlock Text="Cashier:" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptCashier" Text="Rich Roque" FontSize="9.5" Foreground="#0F172A" Margin="80,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 3. Itemized Charges Table -->
                                <Border BorderBrush="#0F172A" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Table Header -->
                                        <Border Background="#E2E8F0" BorderBrush="#0F172A" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="ITEM" FontSize="9.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="DESCRIPTION / NATURE OF SERVICE" FontSize="9.5" FontWeight="Bold" Foreground="#0F172A" Margin="6,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="QTY" FontSize="9.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="UNIT PRICE" FontSize="9.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="9.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <!-- Items List -->
                                        <ItemsControl x:Name="icReceiptItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6" Background="#FFFFFF">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="35"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="55"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ItemNo}" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="9.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" FontSize="9.5" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding FormattedUnitPrice}" FontSize="9.5" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding FormattedAmount}" FontSize="9.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Financial Summary & Totals -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Form of Payment & BIR Non-VAT Notice -->
                                    <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,8,0" Background="#F8FAFC">
                                        <StackPanel>
                                            <TextBlock Text="FORM OF PAYMENT &amp; TERMS:" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Payment Mode: " FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptPayment" Text="[X] Cash" FontSize="9.5" FontWeight="Bold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Transaction Status: " FontSize="9.5" FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptStatus" Text="COMPLETED / FULLY PAID" FontSize="9.5" FontWeight="Bold" Foreground="#16A34A"/>
                                            </StackPanel>
                                            <Border Background="#FEE2E2" CornerRadius="2" Padding="6,3" Margin="0,6,0,0">
                                                <TextBlock Text="THIS DOCUMENT IS NOT VALID FOR CLAIM OF INPUT TAX" FontSize="8" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right: Summary Totals -->
                                    <Border Grid.Column="1" BorderBrush="#0F172A" BorderThickness="1" CornerRadius="4" Padding="12,8" Background="#FFFFFF">
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Total Sales / Subtotal:" FontSize="10" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptSubtotal" Text="₱0.00" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Less: Discount / Withholding:" FontSize="10" Foreground="#475569"/>
                                                <TextBlock x:Name="lblReceiptDiscount" Text="-₱0.00" FontSize="10" FontWeight="SemiBold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Separator Background="#0F172A" Margin="0,4"/>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="TOTAL AMOUNT DUE:" FontSize="11" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lblReceiptGrandTotal" Text="₱0.00" FontSize="14" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 5. Signatures -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Received the above service(s) / goods in satisfactory condition." FontSize="8" Foreground="#64748B" TextWrapping="Wrap"/>
                                        <Border BorderBrush="#94A3B8" BorderThickness="0,0,0,1" Margin="0,18,0,2"/>
                                        <TextBlock Text="Customer's Signature over Printed Name" FontSize="8.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="Bike Kings Management System • Certified Authentic Transaction" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <Border BorderBrush="#94A3B8" BorderThickness="0,0,0,1" Margin="0,18,0,2"/>
                                        <TextBlock Text="Cashier / Authorized Signature" FontSize="8.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- Bottom Action Controls -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Height="36" Padding="14,0" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnPrintSavePdf_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🖨️ " FontSize="12"/>
                                                <TextBlock Text="Print / Save PDF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Height="36" Padding="14,0" Background="#241E30" Foreground="#D1CCE0" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnExportSingleInvoice_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄 " FontSize="11"/>
                                                <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <Button Content="Close Receipt" Height="36" Background="#241E30" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Padding="20,0" Click="CloseReceiptModal_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL 2: DAILY AUDIT (X-REPORT / Z-REPORT) MODAL -->
        <Grid x:Name="modalAuditOverlay" Grid.ColumnSpan="2" Background="#B2000000" Visibility="Collapsed">
            <Border Width="450" Background="#16131C" BorderBrush="#2E263B" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblAuditTitle" Grid.Column="0" Text="Daily Audit Report" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Button Grid.Column="1" Width="26" Height="26" Background="#241E2F" BorderThickness="0" Cursor="Hand" Click="CloseAuditModal_Click">
                            <TextBlock Text="✕" FontSize="12" Foreground="#8C849C"/>
                        </Button>
                    </Grid>

                    <Border Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="lblAuditGenerated" Text="Generated: Sep 07, 2026 04:40 AM" FontSize="10" Foreground="#8C849C" Margin="0,0,0,8"/>
                            <TextBlock x:Name="lblAuditCashier" Text="Cashier: Ruby" FontSize="10" Foreground="#8C849C" Margin="0,0,0,12"/>

                            <Border Height="1" Background="#251F30" Margin="0,0,0,10"/>

                            <Grid Margin="0,3">
                                <TextBlock Text="Completed Orders:" FontSize="11" Foreground="#A09BAA"/>
                                <TextBlock x:Name="lblAuditOrdersCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Retail Sales Count:" FontSize="11" Foreground="#A09BAA"/>
                                <TextBlock x:Name="lblAuditRetailCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Job Orders Count:" FontSize="11" Foreground="#A09BAA"/>
                                <TextBlock x:Name="lblAuditJobCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Voided Transactions:" FontSize="11" Foreground="#A09BAA"/>
                                <TextBlock x:Name="lblAuditVoidCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="1" Background="#251F30" Margin="0,8,0,10"/>

                            <TextBlock Text="PAYMENT BREAKDOWN" FontSize="9" FontWeight="Bold" Foreground="#8C849C" Margin="0,0,0,6"/>
                            <Grid Margin="0,3">
                                <TextBlock Text="💵 Cash in Drawer:" FontSize="11" Foreground="#A09BAA"/>
                                <TextBlock x:Name="lblAuditCash" Text="₱0.00" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="📱 GCash Sales:" FontSize="11" Foreground="#A09BAA"/>
                                <TextBlock x:Name="lblAuditGCash" Text="₱0.00" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="💳 Maya Sales:" FontSize="11" Foreground="#A09BAA"/>
                                <TextBlock x:Name="lblAuditMaya" Text="₱0.00" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="1" Background="#251F30" Margin="0,8,0,10"/>

                            <Grid Margin="0,3">
                                <TextBlock Text="Total Net Revenue:" FontSize="13" FontWeight="Black" Foreground="#22C55E"/>
                                <TextBlock x:Name="lblAuditNetRev" Text="₱0.00" FontSize="15" FontWeight="Black" Foreground="#22C55E" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Height="36" Background="#E63956" BorderThickness="0" Cursor="Hand" Click="CloseAuditModal_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Close Report" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>