<Window x:Class="BikeKings_System.Views.Cashier.CashierDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bike Kings Cycle &amp; Motor Repair - Cashier Terminal"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#100E15"
        FontFamily="Segoe UI, sans-serif">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 1. SIDEBAR -->
            <ColumnDefinition Width="240"/>
            <!-- 2. MAIN WORKSPACE -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             1. LEFT SIDEBAR NAVIGATION
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#16131C" BorderBrush="#251F30" BorderThickness="0,0,1,0" Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Cashier Profile Card -->
                    <RowDefinition Height="*"/>
                    <!-- Navigation Tabs -->
                    <RowDefinition Height="Auto"/>
                    <!-- Logout -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👑" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BIKE KINGS" FontSize="17" FontWeight="Black" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="CYCLE &amp; MOTOR REPAIR" FontSize="9.5" FontWeight="Bold" Foreground="#E63956" Margin="28,2,0,0"/>
                </StackPanel>

                <!-- Cashier Profile Card -->
                <Border Grid.Row="1" Background="#110E17" CornerRadius="10" Padding="12" Margin="0,0,0,20" BorderBrush="#251F30" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Circle -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#2A1B28" BorderBrush="#E63956" BorderThickness="1">
                            <TextBlock x:Name="lblAvatarInitial" Text="C" FontSize="14" FontWeight="Bold" Foreground="#E63956" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name & Role Badge -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblCashierName" Text="Cashier" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <Border Background="#2A1B28" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock Text="CASHIER" FontSize="8.5" FontWeight="Bold" Foreground="#E63956"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Tabs -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="TERMINAL" Foreground="#5E586E" FontWeight="Bold" FontSize="9.5" Margin="8,0,0,10"/>

                        <!-- Tab 1: POS Terminal (Active by default) -->
                        <Border x:Name="navTabSales" Background="#E63956" CornerRadius="8" Padding="14,0" Height="40" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="NavTabSales_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛒" FontSize="13" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtNavSales" Text="Sales &amp; Job Orders" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>

                        <!-- Tab 2: Transaction History -->
                        <Border x:Name="navTabHistory" Background="Transparent" CornerRadius="8" Padding="14,0" Height="40" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="NavTabHistory_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📜" FontSize="13" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtNavHistory" Text="Transaction History" FontSize="12.5" FontWeight="SemiBold" Foreground="#9C95AD"/>
                            </StackPanel>
                        </Border>

                        <!-- Tab 3: Inventory (View-Only Inquiry) -->
                        <Border x:Name="navTabInventory" Background="Transparent" CornerRadius="8" Padding="14,0" Height="40" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="NavTabInventory_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="13" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtNavInventory" Text="Inventory" FontSize="12.5" FontWeight="SemiBold" Foreground="#9C95AD"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ACCOUNT" Foreground="#5E586E" FontWeight="Bold" FontSize="9.5" Margin="8,16,0,10"/>

                        <!-- Tab 4: My Profile -->
                        <Border x:Name="navTabProfile" Background="Transparent" CornerRadius="8" Padding="14,0" Height="40" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="NavTabProfile_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="13" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtNavProfile" Text="My Profile" FontSize="12.5" FontWeight="SemiBold" Foreground="#9C95AD"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logout Button -->
                <Button Grid.Row="3" Background="#24141B" Foreground="#FDA4AF" BorderBrush="#541B28" BorderThickness="1" Height="38" Margin="0,16,0,0" Cursor="Hand" Click="BtnLogout_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚪" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Log Out" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             2. TOP HEADER & MAIN WORKSPACE CONTAINER
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <!-- Top App Bar -->
                <RowDefinition Height="*"/>
                <!-- Dynamic Content Views -->
            </Grid.RowDefinitions>

            <!-- Top App Bar (Uniform with Admin) -->
            <Border Grid.Row="0" Background="#131019" BorderBrush="#251F30" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Header Title & Live Clock -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblHeaderTitle" Text="Sales &amp; Job Orders (POS)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="lblLiveClock" Text="Live Clock..." FontSize="11.5" Foreground="#787189" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Right: Register Status & Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Register Active Badge -->
                        <Border Background="#1D2A20" BorderBrush="#274630" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🟢 REGISTER ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#2ECC71"/>
                            </StackPanel>
                        </Border>

                        <!-- No Sale (Drawer) -->
                        <Button Height="34" Background="#221C2B" Foreground="#E2E8F0" BorderBrush="#352C44" BorderThickness="1" Padding="12,0" Margin="0,0,6,0" Cursor="Hand" Click="BtnNoSale_Click" Visibility="Hidden">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="💵 No Sale" FontSize="11" FontWeight="Medium"/>
                        </Button>

                        <!-- Cash Drop -->
                        <Button Height="34" Background="#2A1B28" Foreground="#FDA4AF" BorderBrush="#541B28" BorderThickness="1" Padding="12,0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCashDrop_Click" Visibility="Hidden">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="💸 Cash Drop" FontSize="11" FontWeight="Bold"/>
                        </Button>

                        <!-- X-Report -->
                        <Button Height="34" Background="#221B35" Foreground="#C084FC" BorderBrush="#3B2D5C" BorderThickness="1" Padding="12,0" Margin="0,0,6,0" Cursor="Hand" Click="BtnXReport_Click" Visibility="Hidden">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="📄 X-Report" FontSize="11" FontWeight="Medium"/>
                        </Button>

                        <!-- Z-Report -->
                        <Button Height="34" Background="#132D23" Foreground="#22C55E" BorderBrush="#1C4B36" BorderThickness="1" Padding="12,0" Cursor="Hand" Click="BtnZReport_Click" Visibility="Hidden">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="📄 Z-Report" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Views Container -->
            <Grid Grid.Row="1">

                <!-- ──────────────────────────────────────────
                     VIEW 1: SALES & JOB ORDERS (POS TERMINAL)
                ────────────────────────────────────────── -->
                <ScrollViewer x:Name="viewSalesJobOrders" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                    <Grid Margin="24,18,24,24">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Search, Quick Chips, Cart -->
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="18"/>
                            <!-- Right: Customer Details & Payment Settlement -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN -->
                        <StackPanel Grid.Column="0">

                            <!-- Search & Product/Service Boxes Catalog Card -->
                            <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ADD PRODUCTS &amp; LABOR SERVICES" FontSize="11" FontWeight="Bold" Foreground="#E63956" Margin="0,0,0,10"/>

                                    <!-- Real-time Filter Search Bar -->
                                    <Border Height="38" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="8" Padding="12,0" Margin="0,0,0,10">
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock x:Name="txtSearchPosPlaceholder" Text="🔍 Search parts, items or services by name, SKU..." FontSize="11" Foreground="#6C657A" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtSearchPos" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" TextChanged="TxtSearchPos_TextChanged"/>
                                        </Grid>
                                    </Border>

                                    <!-- Dynamic Category & Services Filter Chips -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                        <StackPanel x:Name="spPosCategoryChips" Orientation="Horizontal"/>
                                    </ScrollViewer>

                                    <!-- Presented Product / Service Boxes Grid -->
                                    <Border Background="#100E15" BorderBrush="#231B2E" BorderThickness="1" CornerRadius="8" Padding="8,8,2,8" MaxHeight="225">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <ItemsControl x:Name="icPosCatalogBoxes">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- Single Product/Service Box Card -->
                                                            <Border Width="156" Height="200" Margin="0,0,8,8" Background="#1A1524" BorderBrush="#2E243D" BorderThickness="1" CornerRadius="8" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="PosCatalogBox_Click">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="BorderBrush" Value="#E63956"/>
                                                                                <Setter Property="Background" Value="#221B30"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="82"/>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="34"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Photo & Top SKU Badge -->
                                                                    <Border Grid.Row="0" CornerRadius="7,7,0,0" Background="#0C0A10" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image Source="{Binding DisplayImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            <Border Background="#D90E0C14" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0">
                                                                                <TextBlock Text="{Binding Code}" FontSize="8" FontWeight="Bold" Foreground="#94A3B8"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>

                                                                    <!-- Name & Clear Remaining Stock Line -->
                                                                    <Border Grid.Row="1" Padding="8,5,8,0">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" MaxHeight="28" LineHeight="14" LineStackingStrategy="BlockLineHeight" ToolTip="{Binding Name}"/>
                                                                            <!-- 📦 Remaining Stock Indicator -->
                                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="Stock: " FontSize="9.5" Foreground="#8C849C" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding StockLabel}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StockFgColor}" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Price & Add (+) Button -->
                                                                    <Border Grid.Row="2" BorderBrush="#251F33" BorderThickness="0,1,0,0" Padding="8,0" VerticalAlignment="Center">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding FormattedPrice}" FontSize="12.5" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center"/>
                                                                            <Button Grid.Column="1" Width="22" Height="22" Content="+" FontSize="13" FontWeight="Bold" Background="#1D2A20" Foreground="#2ECC71" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="BtnAddPosCatalogBox_Click" ToolTip="Add to Cart">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="11">
                                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="bdr" Property="Background" Value="#22C55E"/>
                                                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Empty Placeholder if no matches -->
                                                <StackPanel x:Name="pnlNoPosMatches" Margin="0,20,0,20" HorizontalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock Text="🔍 No matching products or services found." FontSize="11" FontWeight="Bold" Foreground="#6C657A" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Cart Table Card -->
                            <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="12" Padding="16,14" MinHeight="360">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cart Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🛒" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="lblCartTitle" Text="TRANSACTION CART (0 ITEMS)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Background="#24141B" BorderBrush="#541B28" BorderThickness="1" Height="28" Padding="10,0" Cursor="Hand" Click="BtnClearCart_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="🗑️ Clear Cart" FontSize="10" FontWeight="Bold" Foreground="#FDA4AF"/>
                                        </Button>
                                    </Grid>

                                    <!-- Cart Items List -->
                                    <ScrollViewer Grid.Row="1" MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- Table Header -->
                                            <Border Background="#1D1826" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="DESCRIPTION" FontSize="9" FontWeight="Bold" Foreground="#8C849C"/>
                                                    <TextBlock Grid.Column="1" Text="QTY" FontSize="9" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="UNIT PRICE" FontSize="9" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="" FontSize="9" FontWeight="Bold" Foreground="#8C849C"/>
                                                </Grid>
                                            </Border>

                                            <!-- Cart Items -->
                                            <ItemsControl x:Name="icCartItems">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1A1524" BorderBrush="#251F30" BorderThickness="0,0,0,1" Padding="10,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                    <ColumnDefinition Width="90"/>
                                                                    <ColumnDefinition Width="40"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Column 0: Thumbnail + Item Details -->
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <!-- 🖼️ Big Clear Product Picture Thumbnail (56x56) -->
                                                                    <Border Width="56" Height="56" CornerRadius="8" Background="#14101D" BorderBrush="#3D3252" BorderThickness="1.5" Margin="0,0,12,0" ClipToBounds="True">
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding CategoryIcon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            <Image Source="{Binding DisplayImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <!-- Name and Tag -->
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                                                                        <Border Background="{Binding TypeBadgeBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                                            <TextBlock Text="{Binding TypeBadge}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding TypeBadgeFg}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Quantity Controls -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Button Width="24" Height="24" Content="-" Background="#261E33" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnQtyMinus_Click" Tag="{Binding}">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                            </Style>
                                                                        </Button.Resources>
                                                                    </Button>
                                                                    <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                                                    <Button Width="24" Height="24" Content="+" Background="#261E33" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnQtyPlus_Click" Tag="{Binding}">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                            </Style>
                                                                        </Button.Resources>
                                                                    </Button>
                                                                </StackPanel>

                                                                <!-- Price -->
                                                                <TextBlock Grid.Column="2" Text="{Binding FormattedUnitPrice}" FontSize="11" Foreground="#9C95AD" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding FormattedSubtotal}" FontSize="11.5" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                                                <!-- Remove Button -->
                                                                <Button Grid.Column="4" Width="26" Height="26" Background="#2D1214" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnRemoveCartItem_Click" Tag="{Binding}" ToolTip="Remove Item">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Empty Cart Placeholder -->
                                            <StackPanel x:Name="pnlEmptyCart" Margin="0,30,0,30" HorizontalAlignment="Center">
                                                <TextBlock Text="🛒" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBlock Text="Your cart is empty." FontSize="13" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Search products above or click quick labor chips to populate." FontSize="10" Foreground="#6C657A" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT COLUMN -->
                        <StackPanel Grid.Column="2">
                            
                            <!-- Customer & Vehicle Details Card (Appears only when services are in cart) -->
                            <Border x:Name="cardCustomerJobDetails" Visibility="Collapsed" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👤" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Customer &amp; Job Details" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#2A1B28" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="OPTIONAL FOR WALK-IN" FontSize="8.5" FontWeight="Bold" Foreground="#E63956"/>
                                        </Border>
                                    </Grid>

                                    <!-- Customer Name & Contact Number -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Customer Name:" FontSize="10" Foreground="#8C849C" Margin="0,0,0,3"/>
                                            <Border Height="32" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Padding="8,0">
                                                <TextBox x:Name="txtCustomerName" Text="Walk-in Customer" TextChanged="AutoCapitalizeWords_TextChanged" MaxLength="50" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Contact (09xxxxxxxxx):" FontSize="10" Foreground="#8C849C" Margin="0,0,0,3"/>
                                            <Border Height="32" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Padding="8,0">
                                                <TextBox x:Name="txtContactNo" Text="" MaxLength="11" PreviewTextInput="NumberOnly_PreviewTextInput" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Motorcycle Info: Brand, Model, Plate -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MC Brand:" FontSize="10" Foreground="#8C849C" Margin="0,0,0,3"/>
                                            <Border Height="32" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Padding="6,0">
                                                <TextBox x:Name="txtMcBrand" Text="" TextChanged="AutoCapitalizeWords_TextChanged" MaxLength="25" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Model:" FontSize="10" Foreground="#8C849C" Margin="0,0,0,3"/>
                                            <Border Height="32" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Padding="6,0">
                                                <TextBox x:Name="txtMcModel" Text="" TextChanged="AutoCapitalizeWords_TextChanged" MaxLength="30" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Plate No:" FontSize="10" Foreground="#8C849C" Margin="0,0,0,3"/>
                                            <Border Height="32" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Padding="6,0">
                                                <TextBox x:Name="txtPlateNo" Text="" MaxLength="10" PreviewTextInput="AlphanumericDashOnly_PreviewTextInput" TextChanged="TxtPlateNo_TextChanged" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mechanic Assignment -->
                                    <StackPanel>
                                        <TextBlock Text="Assign Mechanic / Service Staff:" FontSize="10" Foreground="#8C849C" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="cmbMechanic" Height="32"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Payment Settlement Card -->
                            <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="💳 PAYMENT &amp; SETTLEMENT" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                                    <!-- Subtotal -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Subtotal:" FontSize="12" Foreground="#8C849C" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="lblSubtotal" Text="₱0.00" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Grid>

                                    <!-- Discount Amount -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Discount Amount:" FontSize="12" Foreground="#8C849C" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Height="30" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Padding="6,0">
                                            <TextBox x:Name="txtDiscount" Text="0.00" PreviewTextInput="DecimalOnly_PreviewTextInput" Background="Transparent" BorderThickness="0" Foreground="#F59E0B" FontSize="12" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" TextChanged="TxtDiscount_TextChanged"/>
                                        </Border>
                                    </Grid>

                                    <Border Height="1" Background="#251F30" Margin="0,0,0,12"/>

                                    <!-- Grand Total Display -->
                                    <Border Background="#14241B" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GRAND TOTAL" FontSize="12" FontWeight="Black" Foreground="#22C55E" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="lblGrandTotal" Text="₱0.00" FontSize="22" FontWeight="Black" Foreground="#22C55E"/>
                                        </Grid>
                                    </Border>

                                    <!-- Payment Method (Cash / E-Wallet) & Amount Tendered -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Payment Method:" FontSize="10" Foreground="#8C849C" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="cmbPaymentMethod" Height="34" SelectionChanged="CmbPaymentMethod_SelectionChanged">
                                                <ComboBoxItem Content="Cash" IsSelected="True"/>
                                                <ComboBoxItem Content="E-Wallet"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Amount Tendered:" FontSize="10" Foreground="#8C849C" Margin="0,0,0,3"/>
                                            <Border Height="34" Background="#1D1826" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Padding="8,0">
                                                <TextBox x:Name="txtAmountTendered" Text="0.00" PreviewTextInput="DecimalOnly_PreviewTextInput" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" TextChanged="TxtAmountTendered_TextChanged"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- E-Wallet Reference Number (Revealed only when E-Wallet is selected) -->
                                    <StackPanel x:Name="pnlReferenceNo" Margin="0,0,0,8" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="E-Wallet Reference Number:" FontSize="10" Foreground="#FDA4AF" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="* REQUIRED (6-30 CHARS)" FontSize="9" FontWeight="Bold" Foreground="#E63956"/>
                                        </Grid>
                                        <Border Height="34" Background="#1D1826" BorderBrush="#541B28" BorderThickness="1" CornerRadius="6" Padding="8,0">
                                            <TextBox x:Name="txtReferenceNo" MaxLength="30" PreviewTextInput="AlphanumericDashOnly_PreviewTextInput" TextChanged="TxtReferenceNo_TextChanged" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Change Due -->
                                    <Grid Margin="0,4,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Change Due:" FontSize="12" Foreground="#8C849C" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="lblChangeDue" Text="₱0.00" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Grid>

                                    <!-- Complete Transaction Button -->
                                    <Button Height="42" Background="#E63956" BorderThickness="0" Cursor="Hand" Click="BtnCompleteTransaction_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✔" FontSize="14" Margin="0,0,8,0" Foreground="#FFFFFF"/>
                                            <TextBlock Text="Complete Transaction" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ──────────────────────────────────────────
                     VIEW 2: TRANSACTION HISTORY (VIEW-ONLY LEDGER)
                ────────────────────────────────────────── -->
                <!-- ──────────────────────────────────────────
                     VIEW 2: TRANSACTION HISTORY (MASTER LEDGER)
                ────────────────────────────────────────── -->
                <ScrollViewer x:Name="viewHistory" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <Grid Margin="24,18,24,24">
                        <!-- SALES & JOB ORDERS MASTER LEDGER (UNIFORM CONTAINER) -->
                        <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <!-- Header & Export Action -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧾" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sales &amp; Job Orders Master Ledger" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Height="34" Padding="14,0" Background="#241E30" Foreground="#D1CCE0" FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="BtnExportLedger_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📄 " FontSize="11.5"/>
                                                        <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <!-- Search & Filter Controls -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Full Width Search Bar -->
                                    <Border Grid.Row="0" Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0" Margin="0,0,0,10">
                                        <Grid VerticalAlignment="Center">
                                            <TextBox x:Name="txtLedgerSearch" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="12" TextChanged="LedgerFilter_Changed"/>
                                            <TextBlock x:Name="txtLedgerSearchPlaceholder" Text="🔍 Search Invoice #, Customer, Cashier, Mechanic..." Foreground="#6B667B" FontSize="12" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtLedgerSearch}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <!-- Filter Dropdowns & Date Controls Row -->
                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbLedgerType" Width="140" Height="32" Margin="0,0,8,6" SelectionChanged="LedgerFilter_Changed">
                                            <ComboBoxItem Content="All Types" IsSelected="True"/>
                                            <ComboBoxItem Content="Sales"/>
                                            <ComboBoxItem Content="Job Orders"/>
                                        </ComboBox>
                                        <ComboBox x:Name="cmbLedgerStatus" Width="130" Height="32" Margin="0,0,8,6" SelectionChanged="LedgerFilter_Changed">
                                            <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                                            <ComboBoxItem Content="Completed"/>
                                            <ComboBoxItem Content="Voided"/>
                                        </ComboBox>
                                        <ComboBox x:Name="cmbLedgerDate" Width="130" Height="32" Margin="0,0,8,6" SelectionChanged="LedgerFilter_Changed">
                                            <ComboBoxItem Content="All Time" IsSelected="True"/>
                                            <ComboBoxItem Content="Today"/>
                                            <ComboBoxItem Content="This Week"/>
                                            <ComboBoxItem Content="This Month"/>
                                            <ComboBoxItem Content="Custom Range"/>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,6">
                                            <TextBlock Text="From:" FontSize="11" Foreground="#8C849C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <DatePicker x:Name="dpLedgerFromDate" Width="120" Height="32" Margin="0,0,8,0" SelectedDateChanged="LedgerDatePicker_SelectedDateChanged"/>
                                            <TextBlock Text="To:" FontSize="11" Foreground="#8C849C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <DatePicker x:Name="dpLedgerToDate" Width="120" Height="32" Margin="0,0,8,0" SelectedDateChanged="LedgerDatePicker_SelectedDateChanged"/>
                                        </StackPanel>
                                        <!-- Clear Filters Button -->
                                        <Button Height="32" Padding="14,0" Background="#241E30" Foreground="#A99ECC" FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,0,6" Click="BtnResetLedgerFilter_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="✕ " FontSize="11.5"/>
                                                            <TextBlock Text="Clear Filters" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                                <!-- Table Headers (Calibrated Proportional Widths Matching Admin) -->
                                <Border Background="#1C1824" Padding="14,10" CornerRadius="6,6,0,0" BorderBrush="#2A2236" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="INVOICE #" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                        <TextBlock Grid.Column="1" Text="TYPE" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                        <TextBlock Grid.Column="2" Text="DATE &amp; TIME" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                        <TextBlock Grid.Column="3" Text="CUSTOMER" FontSize="11" FontWeight="Bold" Foreground="#8C849C" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="4" Text="CASHIER" FontSize="11" FontWeight="Bold" Foreground="#8C849C" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="5" Text="MECHANIC" FontSize="11" FontWeight="Bold" Foreground="#8C849C" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="6" Text="PAYMENT" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                        <TextBlock Grid.Column="7" Text="TOTAL AMOUNT" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                        <TextBlock Grid.Column="8" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                        <TextBlock Grid.Column="9" Text="ACTION" FontSize="11" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- Table Data Rows (High-Performance Virtualized ListView with Instant Scrolling) -->
                                <StackPanel>
                                    <ListView x:Name="icLedger"
                                              MaxHeight="520"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border x:Name="rowBdr" Background="{TemplateBinding Background}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="rowBdr" Property="Background" Value="#1C1726"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#1F1A28" BorderThickness="0,0,0,1" Padding="14,10" Background="Transparent" Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="LedgerRow_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="105"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="115"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="85"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Invoice No -->
                                                        <TextBlock Grid.Column="0" Text="{Binding InvoiceNo}" FontSize="11.5" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                                        <!-- Type Badge -->
                                                        <TextBlock Grid.Column="1" Text="{Binding TypeBadge}" FontSize="11" Foreground="#9C95AD" VerticalAlignment="Center"/>
                                                        <!-- Date & Time -->
                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedDate}" FontSize="11" Foreground="#9C95AD" VerticalAlignment="Center"/>
                                                        <!-- Customer Name -->
                                                        <TextBlock Grid.Column="3" Text="{Binding CustomerName}" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <!-- Cashier Name -->
                                                        <TextBlock Grid.Column="4" Text="{Binding CashierName}" FontSize="11" Foreground="#9C95AD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <!-- Mechanic Name -->
                                                        <TextBlock Grid.Column="5" Text="{Binding MechanicName}" FontSize="11" Foreground="#9C95AD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <!-- Payment Method -->
                                                        <TextBlock Grid.Column="6" Text="{Binding PaymentMethod}" FontSize="11" Foreground="#D1CCE0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                        <!-- Total Amount -->
                                                        <TextBlock Grid.Column="7" Text="{Binding FormattedTotal}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        <!-- Status Pill Badge -->
                                                        <Border Grid.Column="8" Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusTextColor}"/>
                                                        </Border>
                                                        <!-- Action Button: Receipt View/Print -->
                                                        <Button Grid.Column="9" Content="🖨️ Receipt" Height="26" Padding="8,0" Background="#241E30" Foreground="#C084FC" FontSize="10.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Tag="{Binding}" Click="BtnReprintReceipt_Click" ToolTip="View / Print Receipt Slip">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bdr" Property="Background" Value="#382B54"/>
                                                                            <Setter Property="Foreground" Value="#E9D5FF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- Empty Placeholder -->
                                    <StackPanel x:Name="pnlEmptyLedger" Margin="0,40,0,40" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="No transactions found." FontSize="13" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Try adjusting your search query, type, or date filters." FontSize="10" Foreground="#6C657A" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ──────────────────────────────────────────
                     VIEW 3: INVENTORY (VIEW-ONLY INQUIRY & SERVICES)
                ────────────────────────────────────────── -->
                <ScrollViewer x:Name="viewInventory" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <Grid Margin="24,18,24,24">

                        <!-- INVENTORY MASTER CONTAINER -->
                        <Border Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>

                                <!-- Header & Export Action -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📦 " FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="Inventory Masterlist &amp; Stock Operations" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <Border Background="#2D1214" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="CASHIER VIEW-ONLY (INQUIRY MODE)" FontSize="9" FontWeight="Bold" Foreground="#F87171"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1" Height="34" Padding="14,0" Background="#241E30" Foreground="#D1CCE0" FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="BtnExportInvCsv_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📄 " FontSize="11.5"/>
                                                        <TextBlock Text="Export CSV" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Sub-Tab Navigation Bar -->
                                <Border Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="tabBtnProducts" Content="📦 Products &amp; Parts Masterlist" Height="32" Padding="14,0" Background="#E63956" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Click="TabInvProducts_Click">
                                            <Button.Resources>
