                    </Border>

                    <!-- Right Column: Account Security (Change Password) -->
                    <Border Grid.Column="2" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="🔒" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Account Security" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="UPDATE PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#8C849C" Margin="0,0,0,16"/>

                            <StackPanel Margin="0,0,0,14">
