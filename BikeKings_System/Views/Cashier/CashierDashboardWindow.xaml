                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button x:Name="tabBtnServices" Content="🔧 Labor Services Price List" Height="32" Padding="14,0" Background="Transparent" Foreground="#9C95AD" FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand" Click="TabInvServices_Click">
