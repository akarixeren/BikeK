                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Full Name" FontSize="11" Foreground="#8C849C" Margin="0,0,0,6"/>
                                <Border Height="40" Background="#110E17" BorderBrush="#251F30" BorderThickness="1" CornerRadius="8" Padding="14,0">
                                    <TextBlock x:Name="lblProfileFullName" Text="Cashier Staff" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </Border>
