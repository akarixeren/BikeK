                                                                <Grid>
                                                                    <!-- Product Image -->
                                                                    <Image Source="{Binding DisplayImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <!-- Brand Badge (Top-Left) -->
                                                                    <Border Background="#D90E0C14" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0">
                                                                        <TextBlock Text="{Binding BrandName}" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                                                    </Border>
                                                                    <!-- Stock Status Pill (Bottom-Right) -->
                                                                    <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                                                        <TextBlock Text="{Binding StockStatus}" FontSize="8.5" FontWeight="Bold" Foreground="{Binding StatusFgColor}"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <!-- Row 1: Product Name & SKU -->
                                                            <Border Grid.Row="1" Padding="10,8,10,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ProductName}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" MaxHeight="32" LineHeight="15" LineStackingStrategy="BlockLineHeight" ToolTip="{Binding ProductName}"/>
                                                                    <TextBlock Text="{Binding SKU}" FontSize="9.5" FontWeight="Medium" Foreground="#6B667B" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <!-- Row 2: Price & Add To Cart Button -->
                                                            <Border Grid.Row="2" BorderBrush="#1F1A28" BorderThickness="0,1,0,0" Padding="10,0" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- Price -->
                                                                    <TextBlock Grid.Column="0" Text="{Binding UnitPrice, StringFormat=₱{0:N2}}" FontSize="13" FontWeight="Bold" Foreground="#E63956" VerticalAlignment="Center"/>
                                                                    <!-- Add Button (+) -->
                                                                    <Button Grid.Column="1" Width="26" Height="26" Content="+" FontSize="14" FontWeight="Bold" Background="#1D2A20" Foreground="#2ECC71" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="BtnQuickAddToCart_Click" ToolTip="Add to Cart">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="13">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="btnBdr" Property="Background" Value="#22C55E"/>
                                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <!-- Empty Products Placeholder -->
                                    <StackPanel x:Name="pnlEmptyProducts" Margin="0,40,0,40" HorizontalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="No products match your filter criteria." FontSize="13" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ══════════════════════════════════════
                                     SUB-TAB 2: LABOR SERVICES PRICE LIST
                                ══════════════════════════════════════ -->
                                <StackPanel x:Name="pnlServicesTab" Visibility="Collapsed">
                                    <!-- Service Search -->
                                    <Border Background="#110E17" BorderBrush="#2A2236" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0" Margin="0,0,0,16">
                                        <Grid VerticalAlignment="Center">
                                            <TextBox x:Name="txtSearchServices" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="12" TextChanged="TxtSearchServices_TextChanged"/>
                                            <TextBlock x:Name="txtSearchServicesPlaceholder" Text="🔍 Search Repair Service Name (e.g. CVT, Change Oil, Valve Lapping)..." Foreground="#6B667B" FontSize="12" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearchServices}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Table Header -->
                                    <Border Background="#1C1824" Padding="14,10" CornerRadius="6,6,0,0" BorderBrush="#2A2236" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SERVICE ID" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                            <TextBlock Grid.Column="1" Text="SERVICE NAME / DESCRIPTION" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                            <TextBlock Grid.Column="2" Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                            <TextBlock Grid.Column="3" Text="STANDARD LABOR FEE" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                            <TextBlock Grid.Column="4" Text="AVAILABILITY" FontSize="11" FontWeight="Bold" Foreground="#8C849C"/>
                                            <TextBlock Grid.Column="5" Text="ACTION" FontSize="11" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Services Table Rows -->
                                    <StackPanel>
                                        <ItemsControl x:Name="icServicesCatalog">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#1F1A28" BorderThickness="0,0,0,1" Padding="14,10" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ServiceID, StringFormat='SRV-{0:D3}'}" FontSize="11.5" FontWeight="Bold" Foreground="#A855F7" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ServiceName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="Labor &amp; Repair Service" FontSize="11" Foreground="#9C95AD" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding FormattedFee}" FontSize="13" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center"/>
                                                            <!-- Status Pill -->
                                                            <Border Grid.Column="4" Background="#0E2A1E" CornerRadius="4" Padding="6,2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="● Available" Foreground="#2ECC71" FontSize="9.5" FontWeight="Bold"/>
                                                            </Border>
                                                            <!-- Quick Add To Cart Button -->
                                                            <Button Grid.Column="5" Content="🔧 + Labor" Height="26" Padding="8,0" Background="#26183B" Foreground="#E879F9" FontSize="10.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Tag="{Binding}" Click="BtnQuickAddLaborToCart_Click" ToolTip="Add Labor Service directly to POS Cart">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bdr" Property="Background" Value="#3F2063"/>
                                                                                <Setter Property="Foreground" Value="#F5D0FE"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Empty Services Placeholder -->
                                        <StackPanel x:Name="pnlEmptyServices" Margin="0,40,0,40" HorizontalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock Text="🔧" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="No services match your search." FontSize="13" FontWeight="Bold" Foreground="#8C849C" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ──────────────────────────────────────────
                     VIEW 4: MY PROFILE (BALANCED TWO-COLUMN LIKE ADMIN)
                ────────────────────────────────────────── -->
                <Grid x:Name="viewProfile" Margin="24,18,24,24" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Profile Information (Read-Only) -->
                    <Border Grid.Column="0" Background="#16131C" BorderBrush="#251F30" BorderThickness="1" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="👤" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
